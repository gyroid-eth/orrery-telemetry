# Purpose: point ORRERY at the absolute AgentStack Mail database and remove
# the legacy ~/mcp_agent_mail fallback; missing configuration becomes fatal.
# Rollback: restore the previous config entry and backend fallback together.
# Apply from /Users/operator with: patch -p1 < 0001-orrery-mail-db-selector.patch
--- a/.orrery/config.json
+++ b/.orrery/config.json
@@ -1,4 +1,5 @@
 {
   "project_key": "/Users/operator/Syncthing/<vault-directory>",
-  "orrery_root": "/Users/operator/OSS/orrery"
+  "orrery_root": "/Users/operator/OSS/orrery",
+  "mail_db": "/Users/operator/.agentstack/mail/storage.sqlite3"
 }
--- a/OSS/orrery/bridge/orrery_backend.py
+++ b/OSS/orrery/bridge/orrery_backend.py
@@ -78,12 +78,15 @@
     return os.path.expanduser(value) if value is not None else None
 
 
-MAIL_DB = Path(
-    os.path.expanduser(
-        configured_value(("ORRERY_MAIL_DB",), "mail_db")
-        or "~/mcp_agent_mail/storage.sqlite3"
+_configured_mail_db = configured_value(("ORRERY_MAIL_DB",), "mail_db")
+if _configured_mail_db is None:
+    raise RuntimeError(
+        "mail database is not configured; set ORRERY_MAIL_DB or add an "
+        "absolute mail_db to ~/.orrery/config.json"
     )
-)
+if not os.path.isabs(_configured_mail_db):
+    raise RuntimeError("mail database path must be absolute")
+MAIL_DB = Path(_configured_mail_db)
 MAIL_PROJECT_KEY = configured_value(
     ("ORRERY_PROJECT_KEY", "AGENTSTACK_PROJECT_KEY"),
     "project_key",
