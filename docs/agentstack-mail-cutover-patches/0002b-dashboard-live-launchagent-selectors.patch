# 0002b / live dashboard LaunchAgent selectors (prepared only; not applied)
#
# Scope: ~/Library/LaunchAgents/com.operator.agentdashboard.plist only.
# Purpose: keep the installed LaunchAgent environment byte-for-byte aligned
# with the repo-managed plist after 0002 adds the four AgentStack selectors.
#
# Preconditions:
# - apply 0002 to the repo-managed dashboard copy first
# - require the live before-image SHA-256 recorded in the sealed inventory
# - strict dry-run must pass without offset, fuzz, warning, .orig, or .rej
#
# Rollback:
# - reverse this patch and reload the old dashboard job before restoring 0002
# - verify the restored live digest equals the sealed before-image
#
# Apply only in the maintainer-approved cutover window, from /Users/operator:
# patch --batch --forward --fuzz=0 --no-backup-if-mismatch -p1 < 0002b-dashboard-live-launchagent-selectors.patch
--- a/Library/LaunchAgents/com.operator.agentdashboard.plist
+++ b/Library/LaunchAgents/com.operator.agentdashboard.plist
@@ -24,6 +24,14 @@
   <dict>
     <key>PATH</key>
     <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
+    <key>AGENTSTACK_MAIL_DB</key>
+    <string>/Users/operator/.agentstack/mail/storage.sqlite3</string>
+    <key>AGENTSTACK_MCP_URL</key>
+    <string>http://127.0.0.1:18765/mcp</string>
+    <key>AGENTSTACK_SIGNALS_DIR</key>
+    <string>/Users/operator/.agentstack/mail/signals</string>
+    <key>AGENTSTACK_SCIENTISTS_SCRIPT</key>
+    <string>/Users/operator/.agentstack/bin/lib/agentstack-scientists.sh</string>
   </dict>
 </dict>
 </plist>
