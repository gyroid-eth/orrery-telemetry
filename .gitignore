# local config & secrets
.env
agentstack.toml

# agent-mail is fetched at install time, not vendored
mcp_agent_mail/
# ...except the excerpt the naming-patch tests match their anchors against. It
# has to sit at agent-mail's real path to be a fair test, which this rule would
# otherwise swallow silently: green here, missing fixture in CI.
!tests/fixtures/agent_mail_stock/src/mcp_agent_mail/

# runtime / data
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log
annotations.json
__pycache__/
*.pyc
.DS_Store

# built demo bundle (regenerate with dashboard/demo/build.sh)
dashboard/demo/dist/

# wrangler local state
.wrangler/
