#!/bin/bash
# Minimal lifecycle controller for the supervised AgentStack Mail runner.
#
# The runner owns crash recovery.  This controller owns operator actions and
# refuses to signal a PID unless its controller-written marker names the exact
# rendered runner for this install (and its command line matches when the
# process table is visible).
set -u

PROG="agentstack-mailctl"

say() { printf '%s\n' "$*"; }
die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

AGENTSTACK_HOME="${AGENTSTACK_HOME:-$HOME/.agentstack}"
if [[ "${AGENTSTACK_MAILCTL_SKIP_ENV:-0}" != "1" && -f "$AGENTSTACK_HOME/env.sh" ]]; then
  # shellcheck disable=SC1090
  . "$AGENTSTACK_HOME/env.sh"
fi

MAIL_PROVIDER="${AGENTSTACK_MAIL_PROVIDER:-}"
MAIL_SERVICE_ROOT="${AGENTSTACK_MAIL_DIR:-$AGENTSTACK_HOME/mail-service}"
MAIL_ENV="${AGENTSTACK_MAIL_ENV:-}"
MCP_URL="${AGENTSTACK_MCP_URL:-http://127.0.0.1:18765/mcp}"
MAIL_DB="${AGENTSTACK_MAIL_DB:-}"
PYTHON_BIN="${AGENTSTACK_PYTHON:-python3}"
MAIL_RUNNER="${AGENTSTACK_MAIL_RUNNER:-}"
if [[ -z "$MAIL_RUNNER" && -n "$MAIL_ENV" ]]; then
  MAIL_RUNNER="$(dirname "$MAIL_ENV")/run-agentstack-mail.sh"
fi
RUNTIME_DIR="${AGENTSTACK_MAIL_RUNTIME_DIR:-$MAIL_SERVICE_ROOT/runtime}"
# An explicit `stop` has to outlive the command: the installed autostart trigger
# calls `start` every few minutes, so without a recorded intent it would simply
# undo the operator's stop at the next sweep. Measured: stop → "AgentStack Mail
# stopped" → next sweep → "AgentStack Mail started (pid ...)".
STOPPED_MARKER="${AGENTSTACK_MAIL_STOPPED_MARKER:-$RUNTIME_DIR/agentstack-mail.stopped}"
# Set by the autostart unit. A sweep must never override intent, and must stay
# quiet when there is nothing to do (it runs ~105k times a year).
SWEEP="${AGENTSTACK_MAILCTL_SWEEP:-0}"
PIDFILE="${AGENTSTACK_MAIL_PIDFILE:-$RUNTIME_DIR/agentstack-mail.pid}"
LOGFILE="${AGENTSTACK_MAIL_LOG:-$RUNTIME_DIR/agentstack-mail.log}"
CONTROL_LOCK="${AGENTSTACK_MAIL_CONTROL_LOCK:-$RUNTIME_DIR/agentstack-mailctl.lock}"
LOCK_HELD=0

usage() {
  cat <<'EOF'
Usage: agentstack-mailctl {start|status|stop|restart}

Controls the AgentStack Mail supervised-background service recorded by the
installed env.sh. status exits 0 only for a managed, healthy service; a cleanly
stopped service exits 3.
EOF
}

validate_config() {
  [[ "$MAIL_PROVIDER" == "agentstack" ]] || \
    die "this controller only manages AGENTSTACK_MAIL_PROVIDER=agentstack"
  [[ -n "$MAIL_ENV" ]] || die "AGENTSTACK_MAIL_ENV is not configured"
  [[ -n "$MAIL_RUNNER" ]] || die "the rendered AgentStack Mail runner is not configured"
  [[ "$MCP_URL" == http://* || "$MCP_URL" == https://* ]] || \
    die "AGENTSTACK_MCP_URL must be an HTTP(S) URL"
  command -v "$PYTHON_BIN" >/dev/null 2>&1 || \
    die "configured Python is unavailable: $PYTHON_BIN"
}

# --- launchd-supervised installs -------------------------------------------
#
# The service can be supervised two ways and they used to disagree. The plist
# runs `agentstack-mail-service foreground ...` directly, while this controller
# only recognises a process started through run-agentstack-mail.sh -- so on a
# launchd install `status`, `stop` and `restart` all died with "endpoint is
# occupied without a live managed pid" against a perfectly healthy server, and
# the operator had to fall back to raw launchctl. Reported by a tester on
# 2026-08-17.
#
# When launchd owns the endpoint, defer to it. It is the supervisor; signalling
# its child behind its back is what produced the ambiguity in the first place.
DEFAULT_MAIL_LAUNCHD_LABEL="org.orrery.mail"
MAIL_LAUNCHD_LABEL="${AGENTSTACK_MAIL_LAUNCHD_LABEL:-$DEFAULT_MAIL_LAUNCHD_LABEL}"

# Detection was not prevention: a test that stopped the developer's own service
# was found only after five investigations of what looked like the service
# crashing on its own. Under pytest, resolving to the built-in default label is
# refused -- a test that means to exercise launchd delegation names its own
# label (directly, or through the install it created with AGENTSTACK_LABEL_PREFIX).
# The condition is the label this run will actually act on. An earlier version
# also accepted a test-looking AGENTSTACK_LABEL_PREFIX, which does not change
# the target at all: a test could carry a scoped prefix and still stop the
# production job.
if [[ -n "${PYTEST_CURRENT_TEST:-}" && "$MAIL_LAUNCHD_LABEL" == "$DEFAULT_MAIL_LAUNCHD_LABEL" ]]; then
  printf '%s: refusing to act on the default launchd label (%s) from a test.\n' \
    "$PROG" "$MAIL_LAUNCHD_LABEL" >&2
  printf 'Set AGENTSTACK_MAIL_LAUNCHD_LABEL to a label the test owns.\n' >&2
  exit 3
fi
LAUNCHD_PLIST_MEMO="${AGENTSTACK_MAIL_LAUNCHD_MEMO:-$RUNTIME_DIR/agentstack-mail.launchd-plist}"

launchd_available() {
  [[ "$(uname -s)" == "Darwin" ]] && command -v launchctl >/dev/null 2>&1
}

launchd_service_target() {
  printf 'gui/%s/%s' "$(id -u)" "$MAIL_LAUNCHD_LABEL"
}

launchd_supervises_mail() {
  launchd_available || return 1
  launchctl print "$(launchd_service_target)" >/dev/null 2>&1
}

# Is the loaded job the one this install supervises?
#
# "A label is loaded" is not ownership: a job carrying the expected label may
# belong to something else entirely, and acting on it would boot out a stranger.
# Two independent checks, both required when they are available:
#
#   * the job runs this service (its Program/ProgramArguments name our runner or
#     the mail service entry point), and
#   * when the endpoint is being served, the listener is that job or its child.
#
# Anything unproven fails closed. A controller that assumes ownership when it
# cannot check is the failure this guard exists to prevent.
# Read a plist structurally. Searching the whole document conflates the Label
# with what the job runs, and the labels we look for are themselves the strings
# being searched for -- the check would confirm itself.
plist_defines_this_service() {
  local plist="$1" label program
  [[ -f "$plist" && ! -L "$plist" ]] || return 1
  command -v /usr/bin/plutil >/dev/null 2>&1 || return 1
  label="$(/usr/bin/plutil -extract Label raw -o - "$plist" 2>/dev/null)" || return 1
  [[ "$label" == "$MAIL_LAUNCHD_LABEL" ]] || return 1
  program="$(/usr/bin/plutil -extract Program raw -o - "$plist" 2>/dev/null)" ||
    program="$(/usr/bin/plutil -extract ProgramArguments.0 raw -o - "$plist" 2>/dev/null)" || return 1
  executable_is_this_service "$program"
}

# Only the executable, never its arguments: an editor invoked with
# "--note=agentstack-mail-service" is not this service, and matching the whole
# argument vector said it was.
#
# Canonicalise before judging, then judge the canonical path alone. Names are
# matched exactly (a wildcard accepted "not-agentstack-mail-service-backup"),
# the file has to exist and be executable, and a link is followed to what it
# really runs -- in both directions, so a differently-named link to the real
# service still resolves to it.
executable_is_this_service() {
  local executable="$1" resolved=""
  [[ -n "$executable" ]] || return 1
  [[ -e "$executable" ]] || return 1
  resolved="$(/usr/bin/python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$executable" 2>/dev/null)" || return 1
  [[ -n "$resolved" && -f "$resolved" && -x "$resolved" ]] || return 1
  case "${resolved##*/}" in
    agentstack-mail-service|agentstack_mail|run-agentstack-mail.sh) return 0 ;;
  esac
  case "/${resolved%/*}/" in
    */agentstack_mail/*|*/agentstack-mail/*|*/mail-service/*) return 0 ;;
  esac
  return 1
}

# Read a plist structurally. Searching the whole document conflates the Label
# with what the job runs, and the labels we look for are themselves the strings
# being searched for -- the check would confirm itself.
launchd_job_program() {
  # The authoritative "program =" line only. The numbered "N = ..." lines are
  # the job's arguments, and one of those containing a familiar string says
  # nothing about what is being run.
  launchctl print "$(launchd_service_target)" 2>/dev/null |
    sed -n 's/^[[:space:]]*program = \(.*\)$/\1/p' | head -n 1
}

launchd_job_runs_this_service() {
  executable_is_this_service "$(launchd_job_program)"
}

launchd_listener_belongs_to_job() {
  local job_pid listener_pid port parent
  job_pid="$(launchd_service_pid)"
  [[ -n "$job_pid" ]] || return 1
  port="${MCP_URL##*:}"
  port="${port%%/*}"
  command -v lsof >/dev/null 2>&1 || return 1
  listener_pid="$(lsof -ti "tcp:$port" -sTCP:LISTEN 2>/dev/null | head -n 1)"
  [[ -n "$listener_pid" ]] || return 1
  [[ "$listener_pid" == "$job_pid" ]] && return 0
  parent="$(ps -o ppid= -p "$listener_pid" 2>/dev/null | tr -d " ")"
  [[ "$parent" == "$job_pid" ]]
}

# One snapshot, three answers. Asking "is a job loaded?" and "is it ours?" as
# separate questions collapses absent and foreign into the same false, and a job
# that appears between the two calls is then treated as absent -- which is how a
# foreign job survived while an unsupervised runner started beside it.
launchd_state() {
  if ! launchd_supervises_mail; then
    printf 'absent\n'
    return 0
  fi
  if launchd_job_is_ours; then
    printf 'ours\n'
  else
    printf 'foreign\n'
  fi
}

launchd_job_is_ours() {
  launchd_supervises_mail || return 1
  launchd_job_runs_this_service || return 1
  # Only insist on the listener when something is actually serving; a loaded
  # job with a closed endpoint is exactly what an operator means to start or
  # stop.
  if endpoint_port_open; then
    launchd_listener_belongs_to_job || return 1
  fi
  return 0
}

launchd_service_plist() {
  launchctl print "$(launchd_service_target)" 2>/dev/null |
    sed -n 's/^[[:space:]]*path = \(.*\)$/\1/p' | head -n 1
}

launchd_service_pid() {
  launchctl print "$(launchd_service_target)" 2>/dev/null |
    sed -n 's/^[[:space:]]*pid = \([0-9][0-9]*\).*/\1/p' | head -n 1
}

pid_running() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

read_pid() {
  sed -n '1{s/[[:space:]].*$//;p;}' "$PIDFILE" 2>/dev/null || true
}

pid_is_managed_runner() {
  local pid="$1"
  local recorded_runner
  local command_line
  [[ -n "$MAIL_RUNNER" ]] || return 1
  recorded_runner="$(sed -n '2p' "$PIDFILE" 2>/dev/null || true)"
  [[ "$recorded_runner" == "$MAIL_RUNNER" ]] || return 1
  command_line="$(ps -ww -o command= -p "$pid" 2>/dev/null || true)"
  # Some managed sandboxes deny process-table reads. The controller-owned
  # runner marker plus exact endpoint/database health remains the fallback.
  [[ -z "$command_line" ]] && return 0
  case "$command_line" in
    *"$MAIL_RUNNER"*) return 0 ;;
    *) return 1 ;;
  esac
}

endpoint_port_open() {
  "$PYTHON_BIN" - "$MCP_URL" <<'PY'
import socket
import sys
from urllib.parse import urlparse

parsed = urlparse(sys.argv[1])
host = parsed.hostname
port = parsed.port or (443 if parsed.scheme == "https" else 80)
if not host:
    raise SystemExit(1)
try:
    with socket.create_connection((host, port), timeout=0.4):
        pass
except OSError:
    raise SystemExit(1)
PY
}

health_ok() {
  "$PYTHON_BIN" - "$MCP_URL" "$MAIL_DB" <<'PY'
import json
import pathlib
import sys
import urllib.request

url, expected_db = sys.argv[1:]
payload = json.dumps({
    "jsonrpc": "2.0",
    "id": "agentstack-mailctl",
    "method": "tools/call",
    "params": {"name": "health_check", "arguments": {}},
}).encode()
request = urllib.request.Request(
    url,
    data=payload,
    headers={
        "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream",
    },
    method="POST",
)
try:
    with urllib.request.urlopen(request, timeout=1) as response:
        raw = response.read().decode("utf-8", errors="replace")
except Exception:
    raise SystemExit(1)
for line in raw.splitlines():
    if line.startswith("data:"):
        raw = line[5:].strip()
        break
try:
    result = json.loads(raw).get("result", {})
    health = result.get("structuredContent", result)
except (AttributeError, json.JSONDecodeError):
    raise SystemExit(1)
if not isinstance(health, dict) or health.get("status") != "ok":
    raise SystemExit(1)
if expected_db:
    database_url = str(health.get("database_url", ""))
    for prefix in ("sqlite+aiosqlite:///", "sqlite:///"):
        if database_url.startswith(prefix):
            actual = pathlib.Path(database_url[len(prefix):]).resolve()
            break
    else:
        raise SystemExit(1)
    if actual != pathlib.Path(expected_db).resolve():
        raise SystemExit(1)
PY
}

release_lock() {
  local owner=""
  if [[ "$LOCK_HELD" -eq 1 ]]; then
    owner="$(sed -n '1p' "$CONTROL_LOCK/pid" 2>/dev/null || true)"
    if [[ "$owner" == "$$" ]]; then
      rm -f "$CONTROL_LOCK/pid"
      rmdir "$CONTROL_LOCK" 2>/dev/null || true
    fi
    LOCK_HELD=0
  fi
}

acquire_lock() {
  local owner=""
  mkdir -p "$RUNTIME_DIR"
  if mkdir "$CONTROL_LOCK" 2>/dev/null; then
    printf '%s\n' "$$" > "$CONTROL_LOCK/pid"
    LOCK_HELD=1
    trap release_lock EXIT INT TERM
    return
  fi
  owner="$(sed -n '1p' "$CONTROL_LOCK/pid" 2>/dev/null || true)"
  if pid_running "$owner"; then
    die "another lifecycle action is active (pid $owner)"
  fi
  rm -f "$CONTROL_LOCK/pid"
  rmdir "$CONTROL_LOCK" 2>/dev/null || \
    die "stale lifecycle lock could not be removed: $CONTROL_LOCK"
  mkdir "$CONTROL_LOCK" || die "could not acquire lifecycle lock: $CONTROL_LOCK"
  printf '%s\n' "$$" > "$CONTROL_LOCK/pid"
  LOCK_HELD=1
  trap release_lock EXIT INT TERM
}

write_pid() {
  local pid="$1"
  local temporary="$PIDFILE.tmp.$$"
  umask 077
  printf '%s\n%s\n' "$pid" "$MAIL_RUNNER" > "$temporary"
  mv "$temporary" "$PIDFILE"
}

wait_for_health() {
  local attempts=0
  while [[ "$attempts" -lt 150 ]]; do
    health_ok && return 0
    sleep 0.2
    attempts=$((attempts + 1))
  done
  return 1
}

wait_for_stop() {
  local pid="$1"
  local attempts=0
  while [[ "$attempts" -lt 150 ]]; do
    if ! pid_running "$pid" && ! endpoint_port_open; then
      return 0
    fi
    sleep 0.1
    attempts=$((attempts + 1))
  done
  return 1
}

start_service() {
  # A launchd install starts through launchd, not through the runner wrapper:
  # starting our own would put a second server on the same endpoint.
  if [[ ! -e "$LAUNCHD_PLIST_MEMO" ]] || launchd_supervises_mail; then
    :
  else
    # We booted this job out in a previous `stop`. Put the supervisor back
    # rather than starting a second, unsupervised server next to where launchd
    # will start one at the next login.
    local memo_label memo_plist
    memo_label="$(sed -n 's/^label=//p' "$LAUNCHD_PLIST_MEMO" 2>/dev/null | head -n 1)"
    memo_plist="$(sed -n 's/^plist=//p' "$LAUNCHD_PLIST_MEMO" 2>/dev/null | head -n 1)"
    # A receipt is an instruction to load a launchd job, so treat it as one:
    # wrong label, missing file, or a definition that is not this service means
    # something changed underneath us. Say so rather than loading it, and never
    # fall through to an unsupervised runner -- that silently demotes an install
    # that launchd will contradict at the next login.
    [[ "$memo_label" == "$MAIL_LAUNCHD_LABEL" ]] || \
      die "recorded launchd job is for '$memo_label', not '$MAIL_LAUNCHD_LABEL'; remove $LAUNCHD_PLIST_MEMO if it is stale"
    [[ -n "$memo_plist" && -f "$memo_plist" ]] || \
      die "recorded launchd plist is missing ($memo_plist); remove $LAUNCHD_PLIST_MEMO if it is stale"
    plist_defines_this_service "$memo_plist" || \
      die "recorded plist $memo_plist does not define $MAIL_LAUNCHD_LABEL running this service"
    launchctl bootstrap "gui/$(id -u)" "$memo_plist" >/dev/null 2>&1 || true
    if launchd_supervises_mail; then
      rm -f "$LAUNCHD_PLIST_MEMO"
      if wait_for_health; then
        say "AgentStack Mail started by launchd (label $MAIL_LAUNCHD_LABEL)"
        return 0
      fi
      die "launchd job $MAIL_LAUNCHD_LABEL was restored but the endpoint is not healthy"
    fi
    die "could not restore launchd job $MAIL_LAUNCHD_LABEL from $memo_plist"
  fi
  local launchd_now
  launchd_now="$(launchd_state)"
  if [[ "$launchd_now" == "foreign" ]]; then
    # Someone else's job holds the label this install supervises. Starting our
    # own runner beside it leaves two supervisors for one endpoint, and the
    # collision surfaces at the next login instead of here.
    die "launchd job $MAIL_LAUNCHD_LABEL is loaded but is not this service; resolve that before starting mail"
  fi
  if [[ "$launchd_now" == "ours" ]]; then
    if endpoint_port_open && health_ok; then
      [[ "$SWEEP" == "1" ]] || say "AgentStack Mail already running under launchd (label $MAIL_LAUNCHD_LABEL)"
      return 0
    fi
    launchctl kickstart "$(launchd_service_target)" >/dev/null 2>&1 || true
    if wait_for_health; then
      say "AgentStack Mail started by launchd (label $MAIL_LAUNCHD_LABEL)"
      return 0
    fi
    die "launchd job $MAIL_LAUNCHD_LABEL did not bring the endpoint up"
  fi

  local pid
  [[ -f "$MAIL_ENV" ]] || die "service env is missing: $MAIL_ENV"
  [[ -f "$MAIL_RUNNER" ]] || die "rendered service runner is missing: $MAIL_RUNNER"
  pid="$(read_pid)"
  if pid_running "$pid"; then
    pid_is_managed_runner "$pid" || \
      die "pidfile points to a process other than the rendered runner (pid $pid)"
    health_ok || die "managed runner pid $pid is alive but AgentStack Mail health is failing"
    [[ "$SWEEP" == "1" ]] || say "AgentStack Mail already running (pid $pid, endpoint $MCP_URL)"
    return
  fi
  if [[ -n "$pid" ]]; then
    rm -f "$PIDFILE"
  fi
  case "$(launchd_state)" in
    foreign)
      die "launchd job $MAIL_LAUNCHD_LABEL became loaded and is not this service; refusing to start a second server"
      ;;
    ours)
      if wait_for_health; then
        say "AgentStack Mail started by launchd (label $MAIL_LAUNCHD_LABEL)"
        return 0
      fi
      die "launchd job $MAIL_LAUNCHD_LABEL became loaded but the endpoint is not healthy"
      ;;
  esac
  if endpoint_port_open; then
    if health_ok; then
      die "a healthy AgentStack Mail endpoint exists without this controller's pidfile"
    fi
    die "the configured AgentStack Mail port is owned by another or unhealthy listener"
  fi
  # Re-check at the last moment. The state read at the top of this function was
  # taken before the health probes, and a login or a manual load can arrive in
  # that window -- which is how a foreign job survived while an unsupervised
  # runner started beside it. Every state matters here, not just the foreign
  # one: if our own job appeared, launchd is starting the server and a second
  # one from here would collide with it.
  mkdir -p "$RUNTIME_DIR"
  # Immediately before the spawn, not merely before the probes. The earlier
  # check happens before endpoint_port_open and health_ok, and a job loading in
  # that window still ends with two supervisors for one endpoint -- measured.
  case "$(launchd_state)" in
    foreign)
      die "launchd job $MAIL_LAUNCHD_LABEL became loaded and is not this service; refusing to start a second server"
      ;;
    ours)
      if wait_for_health; then
        say "AgentStack Mail started by launchd (label $MAIL_LAUNCHD_LABEL)"
        return 0
      fi
      die "launchd job $MAIL_LAUNCHD_LABEL became loaded but the endpoint is not healthy"
      ;;
  esac
  nohup /bin/bash "$MAIL_RUNNER" </dev/null >> "$LOGFILE" 2>&1 &
  pid=$!
  write_pid "$pid"
  if ! wait_for_health; then
    if pid_running "$pid" && pid_is_managed_runner "$pid"; then
      kill -TERM "$pid" 2>/dev/null || true
      wait_for_stop "$pid" || true
    fi
    rm -f "$PIDFILE"
    die "AgentStack Mail did not become healthy; inspect $LOGFILE"
  fi
  say "AgentStack Mail started (pid $pid, endpoint $MCP_URL)"
}

stop_service() {
  local pid
  pid="$(read_pid)"
  if ! pid_running "$pid" && launchd_job_is_ours; then
    # launchd restarts whatever we signal, so ask launchd instead. Do this
    # whenever the job is loaded -- a job that is loaded but not currently
    # serving is exactly the one an operator means to stop.
    local plist
    plist="$(launchd_service_plist)"
    # Record what is about to be removed *before* removing it, and refuse to
    # touch the job if the record cannot be written: a stop that unloads the
    # supervisor and then fails to say what it unloaded leaves no way back.
    # No verified way back means no bootout: a stop that cannot record what it
    # removed leaves the operator with an unloaded supervisor and nothing to
    # restore it from.
    [[ -n "$plist" ]] || \
      die "launchd did not report a plist path for $MAIL_LAUNCHD_LABEL; refusing to stop it"
    plist_defines_this_service "$plist" || \
      die "the plist launchd reports for $MAIL_LAUNCHD_LABEL ($plist) does not define this service (or its executable is missing); refusing to stop it"
    if [[ -n "$plist" ]]; then
      mkdir -p "$RUNTIME_DIR" 2>/dev/null || \
        die "cannot create $RUNTIME_DIR to record the launchd job; refusing to stop it"
      umask 077
      printf 'label=%s\nplist=%s\n' "$MAIL_LAUNCHD_LABEL" "$plist" > "$LAUNCHD_PLIST_MEMO.tmp" || \
        die "cannot record the launchd job at $LAUNCHD_PLIST_MEMO; refusing to stop it"
      mv -f "$LAUNCHD_PLIST_MEMO.tmp" "$LAUNCHD_PLIST_MEMO" || \
        die "cannot record the launchd job at $LAUNCHD_PLIST_MEMO; refusing to stop it"
    fi
    launchctl bootout "$(launchd_service_target)" >/dev/null 2>&1 || true
    # bootout is asynchronous: the job outlives the call by a moment.
    local waited=0
    while launchd_supervises_mail || health_ok; do
      # Wait for the job to go *and* for this service to stop answering. The
      # port alone is the wrong signal: something else may hold it, and then
      # this would block on a condition it cannot satisfy.
      if (( waited >= 50 )); then
        die "launchd job $MAIL_LAUNCHD_LABEL is still loaded or still serving"
      fi
      sleep 0.1
      waited=$((waited + 1))
    done
    rm -f "$PIDFILE"
    say "AgentStack Mail stopped (launchd job $MAIL_LAUNCHD_LABEL booted out)"
    return
  fi
  if ! pid_running "$pid"; then
    if launchd_supervises_mail; then
      # Nothing of ours is running, so there is nothing to stop -- but the label
      # this install supervises is held by a job that is not this service, and
      # silence would leave the operator thinking mail is simply stopped.
      say "note: launchd job $MAIL_LAUNCHD_LABEL is loaded but is not this service; leaving it alone"
    fi
    if endpoint_port_open; then
      die "the endpoint is still occupied without a live managed pid; refusing to stop an unknown process"
    fi
    rm -f "$PIDFILE"
    say "AgentStack Mail already stopped"
    return
  fi
  pid_is_managed_runner "$pid" || \
    die "pidfile points to a process other than the rendered runner (pid $pid)"
  kill -TERM "$pid" 2>/dev/null || true
  if ! wait_for_stop "$pid"; then
    if pid_running "$pid" && pid_is_managed_runner "$pid"; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
    wait_for_stop "$pid" || \
      die "managed runner stopped but the configured endpoint remains occupied"
  fi
  rm -f "$PIDFILE"
  say "AgentStack Mail stopped"
}

status_service() {
  local pid
  pid="$(read_pid)"
  if pid_running "$pid"; then
    pid_is_managed_runner "$pid" || \
      die "pidfile points to a foreign process (pid $pid)"
    health_ok || die "managed runner pid $pid is alive but health is failing"
    say "AgentStack Mail running (pid $pid, endpoint $MCP_URL)"
    return 0
  fi
  if endpoint_port_open; then
    if launchd_job_is_ours; then
      local launchd_pid
      launchd_pid="$(launchd_service_pid)"
      health_ok || die "launchd job $MAIL_LAUNCHD_LABEL owns the endpoint but health is failing"
      say "AgentStack Mail running under launchd (label $MAIL_LAUNCHD_LABEL${launchd_pid:+, pid $launchd_pid}, endpoint $MCP_URL)"
      return 0
    fi
    die "endpoint is occupied without a live managed pid"
  fi
  say "AgentStack Mail stopped"
  return 3
}

command="${1:-}"
case "$command" in
  start)
    validate_config
    if [[ "$SWEEP" == "1" && -f "$STOPPED_MARKER" ]]; then
      # Deliberately stopped. Say so once, on stderr, and leave it alone.
      printf '%s: held down by an explicit stop (%s); not starting\n' \
        "$PROG" "$STOPPED_MARKER" >&2
      exit 0
    fi
    acquire_lock
    [[ "$SWEEP" == "1" ]] || rm -f "$STOPPED_MARKER"
    start_service
    ;;
  status)
    validate_config
    status_service
    ;;
  stop)
    validate_config
    acquire_lock
    mkdir -p "$RUNTIME_DIR" 2>/dev/null || true
    : > "$STOPPED_MARKER"
    stop_service
    ;;
  restart)
    validate_config
    acquire_lock
    rm -f "$STOPPED_MARKER"
    if launchd_job_is_ours; then
      # One call, so the job is never left booted out if the start half fails.
      launchctl kickstart -k "$(launchd_service_target)" >/dev/null 2>&1 || \
        die "launchd could not restart $MAIL_LAUNCHD_LABEL"
      wait_for_health || die "launchd restarted $MAIL_LAUNCHD_LABEL but the endpoint is not healthy"
      say "AgentStack Mail restarted by launchd (label $MAIL_LAUNCHD_LABEL)"
    else
      stop_service
      start_service
    fi
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
