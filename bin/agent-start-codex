#!/usr/bin/env bash
# agent-start-codex — launch a Codex CLI agent inside a named tmux session in the
# current terminal tab, registered with ORRERY Mail so it shows up in the dashboard
# and is click-to-jump-able. The Codex counterpart of `agent-start`.
#
# Unlike Claude Code, Codex has no hook system, so this launcher runs
# `agentstack-codex-bootstrap` inside the session to register the agent and
# assign an Adjective-Scientist name before exec'ing codex.
#
# Directory selection (where codex runs):
#   agent-start-codex [DIR]                       use DIR explicitly
#   agent-start-codex --project-key KEY [DIR]     override this invocation
#   agent-start-codex         fzf-pick under $AGENTSTACK_BASE_DIR (default $HOME)
#
# Env:
#   AGENTSTACK_BASE_DIR     root the interactive picker browses (default $HOME)
#   AGENTSTACK_CODEX_BIN    codex binary (default `codex` on PATH)
#   AGENTSTACK_VAULT        extra writable dir for codex --add-dir (optional)
#   AGENTSTACK_CODEX_SANDBOX   codex --sandbox value (default workspace-write)
#   AGENTSTACK_CODEX_APPROVAL  codex --ask-for-approval value (default on-request)
set -euo pipefail

AGS_PROG="agent-start-codex"
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGS_ENTRY_PROJECT_KEY="${AGENTSTACK_PROJECT_KEY:-${PROJECT_KEY:-}}"
AGS_ENTRY_PROTECTED_ROOTS="${AGENTSTACK_PROTECTED_ROOTS:-}"
# shellcheck source=lib/agentstack-launch.sh
. "$BIN_DIR/lib/agentstack-launch.sh"
ags_load_env
if [[ -n "$AGS_ENTRY_PROJECT_KEY" ]]; then
  AGENTSTACK_PROJECT_KEY="$AGS_ENTRY_PROJECT_KEY"
  PROJECT_KEY="$AGS_ENTRY_PROJECT_KEY"
fi
if [[ -n "$AGS_ENTRY_PROTECTED_ROOTS" ]]; then
  AGENTSTACK_PROTECTED_ROOTS="$AGS_ENTRY_PROTECTED_ROOTS"
fi
# shellcheck source=../hooks/project-context.sh
. "$BIN_DIR/../hooks/project-context.sh"

EXPLICIT_PROJECT_KEY=""
LAUNCH_DIR_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project-key)
      [[ $# -ge 2 && -n "${2:-}" ]] || ags_die "--project-key requires a non-empty value"
      EXPLICIT_PROJECT_KEY="$2"
      shift 2
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do LAUNCH_DIR_ARGS+=("$1"); shift; done
      ;;
    -*) ags_die "unknown option: $1" ;;
    *) LAUNCH_DIR_ARGS+=("$1"); shift ;;
  esac
done
[[ ${#LAUNCH_DIR_ARGS[@]} -le 1 ]] || ags_die "expected at most one directory"

CODEX_BIN="${AGENTSTACK_CODEX_BIN:-codex}"
BOOTSTRAP="$BIN_DIR/agentstack-codex-bootstrap"
SANDBOX="${AGENTSTACK_CODEX_SANDBOX:-workspace-write}"
APPROVAL="${AGENTSTACK_CODEX_APPROVAL:-on-request}"

TMUX_BIN="$(ags_resolve_tmux)"
[[ -n "$TMUX_BIN" ]] || ags_die "tmux not found (install tmux first)"
command -v "$CODEX_BIN" >/dev/null 2>&1 || ags_die "codex not found on PATH (set AGENTSTACK_CODEX_BIN)"
[[ -f "$BOOTSTRAP" ]] || ags_die "missing $BOOTSTRAP"

DIR="$(ags_choose_dir ${LAUNCH_DIR_ARGS[@]+"${LAUNCH_DIR_ARGS[@]}"})" || { echo "$AGS_PROG: cancelled" >&2; exit 0; }
[[ -n "$DIR" ]] || exit 0

# Prevent identity hijack; the bootstrap re-exports the selected name after
# registering. Clear the explicit reserved-identity marker as well: this is a
# top-level launcher, never a delegated/resume path.
unset AGENT_NAME PARENT_AGENT CHILD_REGISTRATION_TOKEN AGENTSTACK_RESERVED_IDENTITY 2>/dev/null || true
unset AGENTSTACK_PROJECT_CONTEXT AGENTSTACK_PROJECT_REPOSITORY AGENTSTACK_PROJECT_WORK_DIR 2>/dev/null || true
PROJECT_KEY="$(agentstack_resolve_project_key "$DIR" "" 1 "$EXPLICIT_PROJECT_KEY")"
agentstack_export_project_context "$PROJECT_KEY" "$DIR"
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR 2>/dev/null || true

SESSION="codex-pending-$$"

# Assemble codex flags. OPENAI_API_KEY is stripped because Codex uses ChatGPT
# OAuth; an API key present in the environment overrides and breaks it.
# --add-dir AGENTSTACK_VAULT only when set, so non-Obsidian users aren't forced.
build_codex_cmd() {
  local d="$1" out
  out="env -u OPENAI_API_KEY $(printf '%q' "$CODEX_BIN") -C $(printf '%q' "$d")"
  out+=" --sandbox $(printf '%q' "$SANDBOX") --ask-for-approval $(printf '%q' "$APPROVAL")"
  [[ -n "${AGENTSTACK_VAULT:-}" && -d "${AGENTSTACK_VAULT:-/nonexistent}" ]] \
    && out+=" --add-dir $(printf '%q' "$AGENTSTACK_VAULT")"
  printf '%s' "$out"
}

# Already inside a real tmux pane: register + run codex in place.
if [[ -n "${TMUX:-}" ]]; then
  cd "$DIR"
  export CLAUDECODE=1
  LAUNCH_TMUX_BIN="$TMUX_BIN"  # the sourced bootstrap reassigns TMUX_BIN
  # shellcheck disable=SC1090
  source "$BOOTSTRAP" "$DIR"
  # Publish only after the bootstrap's registration/name gates succeeded: a
  # failed launch must leave the invoking session's project tuple intact.
  # Re-read the name, since the bootstrap may have renamed the session.
  CONTEXT_SESSION="$("$LAUNCH_TMUX_BIN" display-message -p '#S' 2>/dev/null || true)"
  if [[ -n "$CONTEXT_SESSION" ]]; then
    "$LAUNCH_TMUX_BIN" set-environment -t "=$CONTEXT_SESSION" AGENTSTACK_PROJECT_KEY "$PROJECT_KEY"
    "$LAUNCH_TMUX_BIN" set-environment -t "=$CONTEXT_SESSION" PROJECT_KEY "$PROJECT_KEY"
    "$LAUNCH_TMUX_BIN" set-environment -t "=$CONTEXT_SESSION" AGENTSTACK_PROJECT_CONTEXT 1
    "$LAUNCH_TMUX_BIN" set-environment -t "=$CONTEXT_SESSION" AGENTSTACK_PROJECT_REPOSITORY "$AGENTSTACK_PROJECT_REPOSITORY"
    "$LAUNCH_TMUX_BIN" set-environment -t "=$CONTEXT_SESSION" AGENTSTACK_PROJECT_WORK_DIR "$AGENTSTACK_PROJECT_WORK_DIR"
    "$LAUNCH_TMUX_BIN" set-environment -t "=$CONTEXT_SESSION" AGENTSTACK_PROTECTED_ROOTS "$AGENTSTACK_PROTECTED_ROOTS"
  fi
  eval "exec $(build_codex_cmd "$DIR")"
fi

# Otherwise replace the current terminal tab with a fresh tmux session that runs
# the bootstrap (registration + Adjective-Scientist name) and then codex. The temp script
# keeps the tab alive after codex exits, then self-deletes.
CODEX_CMD="$(build_codex_cmd "$DIR")"
INNER="$(mktemp -t agent-start-codex.XXXXXX)"
cat > "$INNER" <<EOF
#!/usr/bin/env bash
cd $(printf '%q' "$DIR") || exit 1
unset AGENT_NAME PARENT_AGENT CHILD_REGISTRATION_TOKEN AGENTSTACK_RESERVED_IDENTITY 2>/dev/null || true
$(printf '%q' "$TMUX_BIN") new-session -s $(printf '%q' "$SESSION") -c $(printf '%q' "$DIR") \
  -e AGENT_NAME= -e PARENT_AGENT= -e CHILD_REGISTRATION_TOKEN= -e AGENTSTACK_RESERVED_IDENTITY= \
  -e CLAUDECODE=1 \
  -e $(printf '%q' "AGENTSTACK_PROJECT_KEY=$PROJECT_KEY") \
  -e $(printf '%q' "PROJECT_KEY=$PROJECT_KEY") \
  -e AGENTSTACK_PROJECT_CONTEXT=1 \
  -e $(printf '%q' "AGENTSTACK_PROJECT_REPOSITORY=$AGENTSTACK_PROJECT_REPOSITORY") \
  -e $(printf '%q' "AGENTSTACK_PROJECT_WORK_DIR=$AGENTSTACK_PROJECT_WORK_DIR") \
  -e $(printf '%q' "AGENTSTACK_PROTECTED_ROOTS=$AGENTSTACK_PROTECTED_ROOTS") \
  "unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR; source $(printf '%q' "$BOOTSTRAP") $(printf '%q' "$DIR") && $CODEX_CMD; exec \"\$SHELL\" -l"
rm -f -- "\$0"
exec "\$SHELL" -l
EOF
chmod +x "$INNER"

echo "$AGS_PROG: launching Codex agent in tmux session '$SESSION' ($DIR)"
exec "$INNER"
