#!/usr/bin/env bash
# Re-register an existing ORRERY Mail identity without exposing its owner token.
#
# Usage: agentstack-reregister <agent-name> [program] [model]
#
# The token is restored internally from child-agent runtime state for delegated
# children, otherwise from CHILD_REGISTRATION_TOKEN or the persisted runtime
# token file. Nothing secret is printed.
set -euo pipefail
set +x 2>/dev/null || true

PROG="agentstack-reregister"

emit_diagnostic() {
  local stage="$1" reason="$2" credential_source="${3:-}"
  local curl_exit="${AGS_REGISTRATION_DIAG_CURL_EXIT:-}"
  local http_status="${AGS_REGISTRATION_DIAG_HTTP_STATUS:-}"
  local rpc_code="${AGS_REGISTRATION_DIAG_RPC_CODE:-}"
  printf '%s: stage=%s reason=%s' "$PROG" "$stage" "$reason" >&2
  case "$credential_source" in
    child-state|inherited|runtime-file)
      printf ' credential_source=%s' "$credential_source" >&2
      ;;
  esac
  [[ "$curl_exit" =~ ^[0-9]+$ ]] && printf ' curl_exit=%s' "$curl_exit" >&2
  [[ "$http_status" =~ ^[0-9]+$ ]] && printf ' http_status=%s' "$http_status" >&2
  [[ "$rpc_code" =~ ^-?[0-9]+$ ]] && printf ' rpc_code=%s' "$rpc_code" >&2
  if [[ "$reason" == "credential-unavailable" ]]; then
    printf ' docs=docs/persistent-agents.md#credential-unavailable operator_action=required' >&2
  fi
  printf '\n' >&2
}

fail_diagnostic() {
  emit_diagnostic "$@"
  exit 1
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/lib/global-client-loader.sh" || { return 2 2>/dev/null || exit 2; }
ags_client_select "$@" && _ags_selected_rc=0 || _ags_selected_rc=$?
[[ "$_ags_selected_rc" == 0 || "$_ags_selected_rc" == 125 ]] || { return "$_ags_selected_rc" 2>/dev/null || exit "$_ags_selected_rc"; }
if [[ "$_ags_selected_rc" == 0 ]]; then
  _ags_mode="$(python3 "$SCRIPT_DIR/lib/runtime_client.py" mode)" || exit 1
  if [[ "$_ags_mode" == "global" ]]; then
    _ags_program="${2:-${AGENTSTACK_REREGISTER_PROGRAM:-}}"
    _ags_model="${3:-${AGENTSTACK_REREGISTER_MODEL:-}}"
    if [[ -n "$_ags_program" || -n "$_ags_model" ]]; then
      _ags_program="${_ags_program:-codex}"
      case "$_ags_program" in
        codex) _ags_default_model="${AGENTSTACK_CODEX_MODEL:-codex}" ;;
        claude-code) _ags_default_model="${AGENTSTACK_CLAUDE_MODEL:-claude-code}" ;;
        *) _ags_default_model="$_ags_program" ;;
      esac
      _ags_result="$(python3 "$SCRIPT_DIR/lib/runtime_client.py" reconnect "$_ags_program" "${_ags_model:-$_ags_default_model}")" || exit 1
    else
      _ags_result="$(python3 "$SCRIPT_DIR/lib/runtime_client.py" reconnect)" || exit 1
    fi
    _ags_name="$(printf '%s' "$_ags_result" | python3 -c 'import json,sys; print(json.load(sys.stdin)["name"])')"
    _ags_reconnect_mode="$(printf '%s' "$_ags_result" | python3 -c 'import json,sys; print(json.load(sys.stdin)["reconnect_mode"])')"
    if [[ "$_ags_reconnect_mode" == "observe-only" ]]; then
      printf 'agentstack-reregister: observed %s (registration not refreshed; pass program/model)\n' "$_ags_name"
      exit 3
    fi
    printf 'agentstack-reregister: registered %s\n' "$_ags_name"
    exit 0
  fi
fi

load_env_file() {
  local envf="$1"
  # shellcheck disable=SC1090
  [[ -n "$envf" && -f "$envf" ]] && . "$envf"
  return 0
}

load_env_file "${AGENTSTACK_ENV_FILE:-}"
load_env_file "${AGENTSTACK_HOME:-$HOME/.agentstack}/env.sh"
load_env_file "$SCRIPT_DIR/../env.sh"

REGISTER_LIB="${AGENTSTACK_REGISTER_LIB:-$SCRIPT_DIR/lib/agentstack-register.sh}"
[[ -f "$REGISTER_LIB" ]] || fail_diagnostic "local-token" "library-unavailable"
# shellcheck disable=SC1090
. "$REGISTER_LIB"

load_child_state_token() {
  local agent_name="$1" state_file runtime_dir
  runtime_dir="$(ags_registration_runtime_dir)"
  state_file="$runtime_dir/child-agents/$agent_name.json"
  [[ -f "$state_file" ]] || return 1
  python3 - "$state_file" <<'PY'
import json
import sys

try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    sys.exit(1)
token = data.get("registration_token")
if not isinstance(token, str) or not token:
    sys.exit(1)
print(token)
PY
}

agent_name="${1:-${AGENT_NAME:-}}"
[[ -n "$agent_name" ]] || fail_diagnostic "local-token" "input-missing"

program="${2:-${AGENTSTACK_REREGISTER_PROGRAM:-codex}}"
case "$program" in
  codex)
    default_model="${AGENTSTACK_CODEX_MODEL:-codex}"
    prefix="cx"
    ;;
  claude-code)
    default_model="${AGENTSTACK_CLAUDE_MODEL:-claude-code}"
    prefix="cc"
    ;;
  *)
    default_model="$program"
    prefix="agent"
    ;;
esac
model="${3:-${AGENTSTACK_REREGISTER_MODEL:-$default_model}}"

project_key="${AGENTSTACK_PROJECT_KEY:-${PROJECT_KEY:-}}"
[[ -n "$project_key" ]] || fail_diagnostic "local-token" "input-missing"

ags_mail_load_token

child_state_token="$(load_child_state_token "$agent_name" 2>/dev/null || true)"
registration_token=""
credential_source=""
if [[ -n "${PARENT_AGENT:-}" && -n "$child_state_token" ]]; then
  registration_token="$child_state_token"
  credential_source="child-state"
fi
if [[ -z "$registration_token" ]]; then
  registration_token="${CHILD_REGISTRATION_TOKEN:-}"
  [[ -n "$registration_token" ]] && credential_source="inherited"
fi
if [[ -z "$registration_token" ]]; then
  registration_token="$(ags_load_registration_token "$agent_name" 2>/dev/null || true)"
  [[ -n "$registration_token" ]] && credential_source="runtime-file"
fi
if [[ -z "$registration_token" && -n "$child_state_token" ]]; then
  registration_token="$child_state_token"
  credential_source="child-state"
fi
[[ -n "$registration_token" ]] || fail_diagnostic "local-token" "credential-unavailable"

CHILD_REGISTRATION_TOKEN="$registration_token"
export CHILD_REGISTRATION_TOKEN

if ags_register_session "$project_key" "$program" "$model" "$prefix" "${PWD:-$project_key}" "$agent_name" "reserved" >/dev/null 2>&1; then
  printf 'agentstack-reregister: registered %s\n' "${AGS_REGISTERED_AGENT_NAME:-$agent_name}"
else
  register_status=$?
  if [[ "$register_status" == "2" && "${AGS_AGENT_NAME_SUBSTITUTED:-0}" == "1" ]]; then
    emit_diagnostic "identity-check" "identity-changed" "$credential_source"
    exit 1
  fi
  diag_stage="${AGS_REGISTRATION_DIAG_STAGE:-register_agent}"
  diag_reason="${AGS_REGISTRATION_DIAG_REASON:-unknown}"
  emit_diagnostic "$diag_stage" "$diag_reason" "$credential_source"
  exit 1
fi
