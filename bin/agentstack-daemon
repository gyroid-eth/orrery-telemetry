#!/usr/bin/env python3
"""Local operator CLI; never an MCP tool or automatic enrollment fallback."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "integrations/codex_app/src"))
sys.path.insert(0, str(ROOT / "packages/agentstack_mail/src"))
from agentstack_codex_app.daemon_runtime import (
    DaemonRuntime,
    DaemonError,
    create_identity,
    finalize_creation,
)


def main():
    parser = argparse.ArgumentParser()
    commands = parser.add_subparsers(dest="operation", required=True)
    create = commands.add_parser(
        "create", help="operator-only, single-attempt identity creation"
    )
    create.add_argument("--connection", required=True)
    create.add_argument("--project-key", required=True)
    create.add_argument("--name", required=True)
    create.add_argument("--journal", required=True)
    create.add_argument("--operator", action="store_true", required=True)
    finalize = commands.add_parser(
        "finalize-create",
        help="operator-only same-journal recovery; no registration retry",
    )
    finalize.add_argument("--connection", required=True)
    finalize.add_argument("--journal", required=True)
    finalize.add_argument("--agent-id", type=int, required=True)
    finalize.add_argument("--operator", action="store_true", required=True)
    inspect = commands.add_parser(
        "inspect", help="verify daemon binding without running the daemon"
    )
    inspect.add_argument("--profile", required=True)
    args = parser.parse_args()
    try:
        if args.operation == "create":
            result = create_identity(
                args.connection,
                project_key=args.project_key,
                name=args.name,
                journal_path=args.journal,
            )
        elif args.operation == "finalize-create":
            result = finalize_creation(
                args.connection, journal_path=args.journal, agent_id=args.agent_id
            )
        else:
            runtime = DaemonRuntime.open(args.profile)
            try:
                result = runtime.call("runtime_status", {})
                runtime.call("whois", {"agent_name": runtime.profile["peer_name"]})
            finally:
                runtime.close()
        print(json.dumps({"ok": True, **result}))
    except Exception as exc:
        # Exception causes can include HTTP/schema inputs and credentials.
        reason = str(exc) if isinstance(exc, DaemonError) else "daemon-command-failed"
        print(
            json.dumps(
                {"ok": False, "reason": reason, "docs": "docs/daemon-agents.md"}
            ),
            file=sys.stderr,
        )
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
