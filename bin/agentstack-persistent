#!/usr/bin/env python3
"""Validate and exec one enrolled persistent AgentStack profile.

The operator enrolls the numeric Mail row separately.  This launcher never
creates or rotates credentials: it verifies the pinned authority, row, name,
and local credential through ``agentstack-enroll inspect`` before preparing a
bound proxy and replacing itself with the profile command.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import time
import tomllib
import uuid
from datetime import date, datetime
from typing import Any, NoReturn, Sequence
from urllib.parse import urlsplit


PROFILE_KIND = "orrery-persistent-agent-v1"
BRIDGE_CONTRACT = "orrery-mail-notification-reply-v1"
DOCS = "docs/persistent-agents.md"
SAFE_NAME = re.compile(r"[A-Za-z0-9_.-]+")
SENSITIVE_ENV = re.compile(r"(?:TOKEN|SECRET|PASSWORD|CREDENTIAL|API_KEY)", re.I)
ALLOWED_PROFILE_KEYS = {
    "kind",
    "name",
    "agent_id",
    "project_key",
    "connection",
    "provider",
    "parentless",
    "lifecycle",
    "interaction",
    "state_dir",
    "working_directory",
    "command",
    "environment",
    "source_home",
    "bridge_contract",
    "description",
}


class PersistentError(RuntimeError):
    pass


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="agentstack-persistent",
        description=(
            "Verify an operator-enrolled persistent identity, prepare its bound "
            "proxy, and exec its interactive CLI or headless bridge."
        ),
        epilog=(
            "First use agentstack-enroll inspect, then claim/recover and verify its "
            "receipt. Start with: agentstack-persistent run --profile PROFILE. "
            f"See {DOCS}."
        ),
    )
    commands = parser.add_subparsers(dest="operation", required=True)
    for operation, help_text in (
        ("inspect", "validate the profile and enrolled row without starting it"),
        ("run", "validate, take the instance lock, and exec the configured process"),
    ):
        command = commands.add_parser(operation, help=help_text)
        command.add_argument("--profile", required=True, help="0600 persistent profile JSON path")
    return parser


def _expand_path(raw: str, *, base: Path | None = None) -> Path:
    path = Path(os.path.expandvars(raw)).expanduser()
    if not path.is_absolute() and base is not None:
        path = base / path
    return path.absolute()


def _read_owned_regular(path: Path, reason: str, *, limit: int = 1_048_576) -> str:
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise PersistentError(reason) from exc
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise PersistentError(reason)
        if stat.S_IMODE(info.st_mode) & 0o077:
            raise PersistentError(reason)
        raw = os.read(descriptor, limit + 1)
    finally:
        os.close(descriptor)
    if len(raw) > limit:
        raise PersistentError(reason)
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise PersistentError(reason) from exc


def _read_private_json(path: Path, reason: str) -> dict[str, Any]:
    try:
        value = json.loads(_read_owned_regular(path, reason))
    except json.JSONDecodeError as exc:
        raise PersistentError(reason) from exc
    if not isinstance(value, dict):
        raise PersistentError(reason)
    return value


def _profile(path: Path) -> dict[str, Any]:
    raw = _read_private_json(path, "profile-invalid")
    if raw.get("kind") != PROFILE_KIND or set(raw) - ALLOWED_PROFILE_KEYS:
        raise PersistentError("profile-invalid")
    name = raw.get("name")
    if not isinstance(name, str) or SAFE_NAME.fullmatch(name) is None:
        raise PersistentError("profile-invalid")
    if type(raw.get("agent_id")) is not int or raw["agent_id"] < 1:
        raise PersistentError("profile-invalid")
    if not isinstance(raw.get("project_key"), str) or not raw["project_key"]:
        raise PersistentError("profile-invalid")
    provider = raw.get("provider")
    if not isinstance(provider, str) or provider not in {"claude", "codex"}:
        raise PersistentError("profile-invalid")
    if raw.get("parentless") is not True or raw.get("lifecycle") != "persistent":
        raise PersistentError("profile-invalid")
    interaction = raw.get("interaction")
    if not isinstance(interaction, str) or interaction not in {"interactive", "headless"}:
        raise PersistentError("profile-invalid")
    for key in ("connection", "state_dir", "working_directory"):
        if not isinstance(raw.get(key), str) or not raw[key]:
            raise PersistentError("profile-invalid")
        raw[key] = str(_expand_path(raw[key], base=path.parent))
    command = raw.get("command")
    if (
        not isinstance(command, list)
        or not command
        or any(not isinstance(item, str) or not item or "\x00" in item for item in command)
    ):
        raise PersistentError("profile-invalid")
    executable_name = Path(command[0]).name
    if raw["interaction"] == "interactive":
        expected_executable = "claude" if raw["provider"] == "claude" else "codex"
        if executable_name != expected_executable:
            raise PersistentError("interactive-provider-command-mismatch")
        if raw["provider"] == "claude" and "--channels" not in command:
            raise PersistentError("interactive-claude-channels-required")
    elif executable_name in {"claude", "codex"}:
        raise PersistentError("headless-bridge-command-required")
    environment = raw.get("environment", {})
    if not isinstance(environment, dict):
        raise PersistentError("profile-invalid")
    forbidden = {
        "AGENT_NAME",
        "PARENT_AGENT",
        "CHILD_REGISTRATION_TOKEN",
        "AGENTSTACK_RESERVED_IDENTITY",
        "AGENTSTACK_PROXY_AGENT_NAME",
        "AGENTSTACK_PROXY_TOKEN_FILE",
    }
    for key, value in environment.items():
        if (
            not isinstance(key, str)
            or not isinstance(value, str)
            or key in forbidden
            or SENSITIVE_ENV.search(key)
        ):
            raise PersistentError("profile-environment-invalid")
    if raw["interaction"] == "headless":
        if raw.get("bridge_contract") != BRIDGE_CONTRACT:
            raise PersistentError("headless-bridge-contract-required")
    elif "bridge_contract" in raw:
        raise PersistentError("profile-invalid")
    if "source_home" in raw:
        if raw["provider"] != "codex" or not isinstance(raw["source_home"], str):
            raise PersistentError("profile-invalid")
        raw["source_home"] = str(_expand_path(raw["source_home"], base=path.parent))
    return raw


def _connection(profile: dict[str, Any]) -> tuple[Path, dict[str, Any], Path]:
    path = Path(profile["connection"])
    value = _read_private_json(path, "connection-profile-invalid")
    if value.get("kind") != "orrery-mail-connection-v1":
        raise PersistentError("connection-profile-invalid")
    pinned = value.get("expected_server_instance_id")
    runtime = value.get("runtime_dir")
    if not isinstance(pinned, str) or not pinned:
        raise PersistentError("connection-not-pinned")
    if not isinstance(runtime, str) or not runtime:
        raise PersistentError("connection-profile-invalid")
    mcp_url = value.get("mcp_url")
    if not isinstance(mcp_url, str) or not mcp_url:
        raise PersistentError("connection-profile-invalid")
    parsed_url = urlsplit(mcp_url)
    if (
        parsed_url.scheme not in {"http", "https"}
        or parsed_url.hostname not in {"127.0.0.1", "localhost", "::1"}
        or parsed_url.username is not None
        or parsed_url.password is not None
    ):
        raise PersistentError("connection-not-local")
    mail_env = value.get("mail_env")
    if not isinstance(mail_env, str) or not mail_env:
        raise PersistentError("connection-profile-invalid")
    value["mail_env"] = str(_expand_path(mail_env, base=path.parent))
    bearer_mode = value.get("http_bearer_mode", "auto")
    if not isinstance(bearer_mode, str) or bearer_mode not in {
        "auto",
        "disabled",
        "required",
    }:
        raise PersistentError("connection-profile-invalid")
    return path, value, _expand_path(runtime, base=path.parent)


def _enroll_inspect(profile: dict[str, Any], connection_path: Path) -> dict[str, Any]:
    sibling = Path(__file__).resolve().with_name("agentstack-enroll")
    executable = Path(
        os.environ.get("AGENTSTACK_ENROLL_BIN")
        or os.environ.get("AGENTSTACK_MAIL_ENROLL_BIN")
        or str(sibling)
    ).expanduser()
    if not executable.is_file() or not os.access(executable, os.X_OK):
        raise PersistentError("enroll-cli-unavailable")
    command = [
        str(executable),
        "inspect",
        "--agent-id",
        str(profile["agent_id"]),
        "--project-key",
        profile["project_key"],
        "--connection",
        str(connection_path),
        "--name",
        profile["name"],
    ]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=15, check=False)
    except (OSError, subprocess.SubprocessError) as exc:
        raise PersistentError("enrollment-inspect-failed") from exc
    if result.returncode != 0:
        raise PersistentError("enrollment-inspect-failed")
    try:
        inspected = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise PersistentError("enrollment-inspect-failed") from exc
    required = {
        "ok": True,
        "agent_id": profile["agent_id"],
        "project_key": profile["project_key"],
        "name": profile["name"],
        "credential_state": "server-token",
        "connection_pinned": True,
    }
    if not isinstance(inspected, dict) or any(inspected.get(k) != v for k, v in required.items()):
        raise PersistentError("enrolled-identity-mismatch")
    local_state = inspected.get("local_credential_state")
    if not isinstance(local_state, str) or local_state not in {
        "present",
        "present-legacy-verified",
    }:
        raise PersistentError("local-credential-unavailable")
    if not isinstance(inspected.get("server_instance_id"), str):
        raise PersistentError("enrolled-identity-mismatch")
    return inspected


def _mkdir_private(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    info = path.stat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077:
        raise PersistentError("state-directory-unsafe")


def _atomic_json(path: Path, value: dict[str, Any]) -> None:
    _mkdir_private(path.parent)
    payload = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.pending")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _proxy_env(
    profile: dict[str, Any], connection: dict[str, Any], runtime_dir: Path, token_file: Path
) -> tuple[Path, dict[str, str]]:
    home = Path(os.environ.get("AGENTSTACK_HOME", str(Path(__file__).resolve().parent.parent)))
    runner = Path(
        os.environ.get(
            "AGENTSTACK_MCP_PROXY",
            str(home / "integrations/codex_app/plugin/scripts/run-mcp.sh"),
        )
    ).expanduser()
    if not runner.is_file() or not os.access(runner, os.X_OK):
        raise PersistentError("proxy-configuration-incomplete")
    environment = {
        "AGENTSTACK_PROXY_AGENT_NAME": profile["name"],
        "AGENTSTACK_PROXY_TOKEN_FILE": str(token_file),
        "AGENTSTACK_PROXY_PROGRAM": "claude-code" if profile["provider"] == "claude" else "codex",
        "AGENTSTACK_PROJECT_KEY": profile["project_key"],
        "AGENTSTACK_MCP_URL": connection["mcp_url"],
        "AGENTSTACK_MAIL_ENV": connection["mail_env"],
        "AGENTSTACK_MAIL_HTTP_BEARER_MODE": connection.get("http_bearer_mode", "auto"),
        "AGENTSTACK_RUNTIME_DIR": str(runtime_dir),
    }
    if os.environ.get("AGENTSTACK_PYTHON"):
        environment["AGENTSTACK_PYTHON"] = os.environ["AGENTSTACK_PYTHON"]
    return runner, environment


def _mail_names_from_claude_config() -> set[str]:
    names = {"orrery-mail", "agentstack"}
    path = Path(os.environ.get("AGENTSTACK_CLAUDE_JSON", str(Path.home() / ".claude.json")))
    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return names
    scopes: list[Any] = [settings.get("mcpServers")] if isinstance(settings, dict) else []
    projects = settings.get("projects") if isinstance(settings, dict) else None
    if isinstance(projects, dict):
        scopes.extend(value.get("mcpServers") for value in projects.values() if isinstance(value, dict))
    for scope in scopes:
        if not isinstance(scope, dict):
            continue
        for name in scope:
            normalized = str(name).replace("-", "").replace("_", "").lower()
            if normalized in {"agentmail", "mcpagentmail", "agentstackmail", "orrerymail"}:
                names.add(str(name))
    return names


def _write_claude_proxy(state_dir: Path, runner: Path, proxy_env: dict[str, str]) -> Path:
    server = {"command": str(runner), "args": [], "env": proxy_env}
    path = state_dir / "proxy" / "claude-mcp.json"
    _atomic_json(path, {"mcpServers": {name: server for name in sorted(_mail_names_from_claude_config())}})
    return path


def _looks_like_mail(name: str) -> bool:
    normalized = name.replace("-", "").replace("_", "").replace('"', "").lower()
    return normalized in {"agentmail", "mcpagentmail", "agentstackmail", "orrerymail", "agentstack"}


def _toml_string(value: str) -> str:
    encoded = json.dumps(value, ensure_ascii=False)
    return "".join(
        "\\u" + format(ord(char), "04x") if 0x7F <= ord(char) <= 0x9F else char
        for char in encoded
    )


def _toml_key(value: str) -> str:
    return value if re.fullmatch(r"[A-Za-z0-9_]+", value) else _toml_string(value)


def _toml_value(value: Any) -> str:
    if isinstance(value, str):
        return _toml_string(value)
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        if math.isnan(value):
            return "nan"
        if math.isinf(value):
            return "-inf" if value < 0 else "inf"
        return repr(value)
    if isinstance(value, (datetime, date)):
        return value.isoformat()
    if isinstance(value, list):
        return "[" + ", ".join(_toml_value(item) for item in value) + "]"
    if isinstance(value, dict):
        return "{ " + ", ".join(
            _toml_key(key) + " = " + _toml_value(item) for key, item in sorted(value.items())
        ) + " }"
    raise PersistentError("codex-config-unsupported")


def _emit_toml(config: dict[str, Any]) -> str:
    output: list[str] = []

    def emit_table(path: tuple[str, ...], table: dict[str, Any], header: str | None) -> None:
        scalars = [
            (key, value)
            for key, value in table.items()
            if not isinstance(value, dict)
            and not (isinstance(value, list) and value and all(isinstance(i, dict) for i in value))
        ]
        children = [(key, value) for key, value in table.items() if isinstance(value, dict)]
        arrays = [
            (key, value)
            for key, value in table.items()
            if isinstance(value, list) and value and all(isinstance(i, dict) for i in value)
        ]
        dotted = ".".join(_toml_key(part) for part in path)
        if header == "table":
            output.append(f"[{dotted}]")
        elif header == "array":
            output.append(f"[[{dotted}]]")
        for key, value in sorted(scalars):
            output.append(f"{_toml_key(key)} = {_toml_value(value)}")
        for key, value in sorted(children):
            if output and output[-1] != "":
                output.append("")
            emit_table(path + (key,), value, "table")
        for key, values in sorted(arrays):
            for value in values:
                if output and output[-1] != "":
                    output.append("")
                emit_table(path + (key,), value, "array")

    emit_table((), config, None)
    return "\n".join(output) + "\n"


def _write_codex_home(
    profile: dict[str, Any], state_dir: Path, runner: Path, proxy_env: dict[str, str]
) -> Path:
    source = Path(
        profile.get("source_home")
        or os.environ.get("CODEX_HOME")
        or str(Path.home() / ".codex")
    ).expanduser()
    if not source.is_dir():
        raise PersistentError("codex-source-home-unavailable")
    target = state_dir / "codex-home"
    _mkdir_private(target)
    if source.resolve() == target.resolve():
        raise PersistentError("codex-source-home-invalid")
    for entry in source.iterdir():
        if entry.name in {"config.toml", ".git", ".agents", ".codex"}:
            continue
        link = target / entry.name
        if not link.exists() and not link.is_symlink():
            link.symlink_to(entry)
    source_config = source / "config.toml"
    try:
        config = tomllib.loads(source_config.read_text(encoding="utf-8")) if source_config.exists() else {}
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise PersistentError("codex-config-invalid") from exc
    servers = config.setdefault("mcp_servers", {})
    if not isinstance(servers, dict):
        raise PersistentError("codex-config-invalid")
    for name in list(servers):
        if _looks_like_mail(str(name)):
            del servers[name]
    plugins = config.get("plugins", {})
    if isinstance(plugins, dict):
        for plugin_id, plugin in plugins.items():
            if str(plugin_id).startswith("agentstack-codex-app@") and isinstance(plugin, dict):
                plugin.setdefault("mcp_servers", {})["agentstack"] = {"enabled": False}
    tools = {
        name: {"approval_mode": "approve"}
        for name in (
            "bootstrap",
            "runtime_status",
            "fetch_inbox",
            "whois",
            "send_message",
            "acknowledge_message",
            "reserve_files",
            "renew_reservations",
            "release_reservations",
        )
    }
    codex_proxy_env = dict(proxy_env)
    codex_proxy_env["AGENTSTACK_CODEX_APP_RUNTIME_DIR"] = str(target / "proxy-runtime")
    for name in ("orrery-mail", "agentstack"):
        servers[name] = {
            "command": str(runner),
            "args": [],
            "env": codex_proxy_env,
            "tools": tools,
        }
    payload = _emit_toml(config).encode()
    config_path = target / "config.toml"
    temporary = target / f".config.toml.{uuid.uuid4().hex}.pending"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        tomllib.loads(payload.decode())
        os.replace(temporary, config_path)
        config_path.chmod(0o600)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
    return target


def _prepare_codex_binding(
    profile: dict[str, Any], runtime_dir: Path
) -> tuple[Path, str]:
    default_hooks = Path(__file__).resolve().parent.parent / "hooks"
    hooks_dir = Path(os.environ.get("AGENTSTACK_HOOKS_DIR", str(default_hooks))).expanduser()
    helper = hooks_dir / "prepare-codex-session-binding.py"
    if not helper.is_file():
        raise PersistentError("codex-binding-helper-unavailable")
    python = os.environ.get("AGENTSTACK_PYTHON") or sys.executable
    command = [
        python,
        str(helper),
        "--runtime-dir",
        str(runtime_dir),
        "--agent-id",
        str(profile["agent_id"]),
        "--agent-name",
        profile["name"],
        "--project-key",
        profile["project_key"],
        "--program",
        "codex",
        "--launch-kind",
        "startup",
        "--history-mode",
        "enabled",
    ]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=15, check=False)
    except (OSError, subprocess.SubprocessError) as exc:
        raise PersistentError("codex-binding-prepare-failed") from exc
    parts = result.stdout.strip().split("\t")
    if result.returncode != 0 or len(parts) != 2:
        raise PersistentError("codex-binding-prepare-failed")
    binding = Path(parts[0]).expanduser().resolve(strict=False)
    expected = (runtime_dir / "codex_launches" / f"{profile['agent_id']}.json").resolve(
        strict=False
    )
    launch_id = parts[1]
    if binding != expected or re.fullmatch(r"[0-9a-f]{32}", launch_id) is None:
        raise PersistentError("codex-binding-prepare-failed")
    return binding, launch_id


def _instance_lock(state_dir: Path) -> int:
    path = state_dir / "instance.lock"
    descriptor = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    os.fchmod(descriptor, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as exc:
        os.close(descriptor)
        raise PersistentError("profile-already-running") from exc
    os.set_inheritable(descriptor, True)
    return descriptor


def _wake_socket(name: str, profile_path: Path) -> Path:
    root = Path("/tmp") / f"orrery-persistent-{os.getuid()}"
    _mkdir_private(root)
    digest = hashlib.sha256(f"{profile_path}\0{name}".encode()).hexdigest()[:24]
    return root / f"{digest}.sock"


def _runtime_manifest(
    runtime_dir: Path,
    profile_path: Path,
    profile: dict[str, Any],
    inspected: dict[str, Any],
    wake_socket: Path | None,
) -> Path:
    path = runtime_dir / "persistent" / f"{profile['name']}.json"
    value: dict[str, Any] = {
        "kind": "orrery-persistent-runtime-v1",
        "pid": os.getpid(),
        "profile_path": str(profile_path),
        "name": profile["name"],
        "agent_id": profile["agent_id"],
        "project_key": profile["project_key"],
        "server_instance_id": inspected["server_instance_id"],
        "provider": profile["provider"],
        "parentless": True,
        "lifecycle": "persistent",
        "interaction": profile["interaction"],
        "started_at": int(time.time()),
    }
    if wake_socket is not None:
        value["wake_socket"] = str(wake_socket)
        value["bridge_contract"] = BRIDGE_CONTRACT
    _atomic_json(path, value)
    return path


def _validated(
    profile_path: Path,
) -> tuple[dict[str, Any], dict[str, Any], Path, dict[str, Any], Path, Path]:
    profile = _profile(profile_path)
    connection_path, connection_value, runtime_dir = _connection(profile)
    inspected = _enroll_inspect(profile, connection_path)
    if inspected["server_instance_id"] != connection_value["expected_server_instance_id"]:
        raise PersistentError("enrolled-authority-mismatch")
    generation = inspected.get("credential_generation")
    fingerprint = inspected.get("credential_fingerprint")
    if (
        type(generation) is not int
        or generation < 0
        or not isinstance(fingerprint, str)
        or re.fullmatch(r"[0-9a-f]{16}", fingerprint) is None
    ):
        raise PersistentError("enrolled-credential-mismatch")
    state_dir = Path(profile["state_dir"])
    workdir = Path(profile["working_directory"])
    if not workdir.is_dir():
        raise PersistentError("working-directory-unavailable")
    _mkdir_private(state_dir)
    return profile, inspected, connection_path, connection_value, runtime_dir, state_dir


def _inspect_output(profile: dict[str, Any], inspected: dict[str, Any]) -> dict[str, Any]:
    return {
        "ok": True,
        "kind": PROFILE_KIND,
        "name": profile["name"],
        "agent_id": profile["agent_id"],
        "project_key": profile["project_key"],
        "server_instance_id": inspected["server_instance_id"],
        "credential_generation": inspected.get("credential_generation"),
        "provider": profile["provider"],
        "parentless": True,
        "lifecycle": "persistent",
        "interaction": profile["interaction"],
        "ready": True,
    }


def _run(profile_path: Path) -> NoReturn:
    profile, inspected, _connection_path, connection, runtime_dir, state_dir = _validated(
        profile_path
    )
    _instance_lock(state_dir)
    token_file = runtime_dir / f"agent_token_{profile['name']}"
    runner, proxy_env = _proxy_env(profile, connection, runtime_dir, token_file)
    environment = dict(os.environ)
    for key in (
        "PARENT_AGENT",
        "CHILD_REGISTRATION_TOKEN",
        "AGENTSTACK_RESERVED_IDENTITY",
        "AGENTSTACK_CODEX_LAUNCH_BINDING",
        "AGENTSTACK_CODEX_LAUNCH_ID",
        "AGENTSTACK_PROXY_AGENT_NAME",
        "AGENTSTACK_PROXY_TOKEN_FILE",
        "AGENTSTACK_PROXY_PROGRAM",
        "AGENTSTACK_CODEX_APP_RUNTIME_DIR",
    ):
        environment.pop(key, None)
    environment.update(profile.get("environment", {}))
    environment.update(
        {
            "AGENT_NAME": profile["name"],
            "AGENTSTACK_PROJECT_KEY": profile["project_key"],
            "AGENTSTACK_RUNTIME_DIR": str(runtime_dir),
            "AGENTSTACK_MCP_URL": connection["mcp_url"],
            "AGENTSTACK_MAIL_ENV": connection["mail_env"],
            "AGENTSTACK_MAIL_HTTP_BEARER_MODE": connection.get(
                "http_bearer_mode", "auto"
            ),
            "AGENTSTACK_PERSISTENT_PROFILE": str(profile_path),
            "AGENTSTACK_PERSISTENT_STATE_DIR": str(state_dir),
            "AGENTSTACK_PERSISTENT_INTERACTION": profile["interaction"],
            "AGENTSTACK_PERSISTENT_LIFECYCLE": "persistent",
            "AGENTSTACK_PERSISTENT_PARENTLESS": "1",
        }
    )
    command = list(profile["command"])
    if profile["provider"] == "claude":
        mcp_config = _write_claude_proxy(state_dir, runner, proxy_env)
        environment["AGENTSTACK_PERSISTENT_MCP_CONFIG"] = str(mcp_config)
        if profile["interaction"] == "interactive":
            if any(
                item == "--mcp-config"
                or item.startswith("--mcp-config=")
                or item == "--strict-mcp-config"
                for item in command
            ):
                raise PersistentError("profile-controls-mcp-config")
            command.extend(["--mcp-config", str(mcp_config), "--strict-mcp-config"])
    else:
        codex_home = _write_codex_home(profile, state_dir, runner, proxy_env)
        environment["CODEX_HOME"] = str(codex_home)
        environment["CODEX_SHARED_CODEX_DIR"] = str(codex_home)
        binding, launch_id = _prepare_codex_binding(profile, runtime_dir)
        environment["AGENTSTACK_CODEX_LAUNCH_BINDING"] = str(binding)
        environment["AGENTSTACK_CODEX_LAUNCH_ID"] = launch_id
    wake_socket = None
    if profile["interaction"] == "headless":
        wake_socket = _wake_socket(profile["name"], profile_path)
        try:
            if wake_socket.is_socket() or wake_socket.is_symlink():
                wake_socket.unlink()
        except OSError as exc:
            raise PersistentError("headless-wake-socket-unsafe") from exc
        environment["AGENTSTACK_PERSISTENT_WAKE_SOCKET"] = str(wake_socket)
        environment["AGENTSTACK_PERSISTENT_BRIDGE_CONTRACT"] = BRIDGE_CONTRACT
    manifest = _runtime_manifest(runtime_dir, profile_path, profile, inspected, wake_socket)
    environment["AGENTSTACK_PERSISTENT_RUNTIME_MANIFEST"] = str(manifest)
    executable = command[0]
    resolved = executable if os.path.isabs(executable) else shutil.which(executable, path=environment.get("PATH"))
    if not resolved or not Path(resolved).is_file() or not os.access(resolved, os.X_OK):
        raise PersistentError("profile-command-unavailable")
    os.chdir(profile["working_directory"])
    os.execvpe(str(resolved), command, environment)
    raise AssertionError("unreachable")


def main(argv: Sequence[str] | None = None) -> None:
    args = _parser().parse_args(argv)
    profile_path = _expand_path(args.profile)
    try:
        if args.operation == "inspect":
            profile, inspected, _connection_path, _connection_value, _runtime_dir, _state_dir = (
                _validated(profile_path)
            )
            print(json.dumps(_inspect_output(profile, inspected), sort_keys=True, separators=(",", ":")))
            return
        _run(profile_path)
    except PersistentError as exc:
        print(
            json.dumps(
                {"ok": False, "reason": str(exc), "docs": DOCS},
                sort_keys=True,
                separators=(",", ":"),
            ),
            file=sys.stderr,
        )
        raise SystemExit(2) from None
    except OSError:
        print(
            json.dumps(
                {"ok": False, "reason": "persistent-launch-failed", "docs": DOCS},
                sort_keys=True,
                separators=(",", ":"),
            ),
            file=sys.stderr,
        )
        raise SystemExit(2) from None


if __name__ == "__main__":
    main()
