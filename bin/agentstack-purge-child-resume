#!/usr/bin/env bash

_ags_global_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/agentstack-register.sh"
if [[ -f "$_ags_global_lib" ]]; then
  . "$_ags_global_lib"
fi
if declare -F ags_global_entry >/dev/null; then
  if ags_global_entry purge-child "$@"; then exit 0; else _ags_global_rc=$?; fi
  [[ "$_ags_global_rc" == 125 ]] || exit "$_ags_global_rc"
elif [[ -n "${AGENTSTACK_CLIENT_CONFIG:-}" || -e "$(dirname "$_ags_global_lib")/../../runtime-client.json" || -L "$(dirname "$_ags_global_lib")/../../runtime-client.json" ]]; then
  printf '%s\n' 'GLOBAL_REGISTER_LIBRARY_UNAVAILABLE' >&2
  exit 2
fi
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
RUNTIME_DIR="${AGENTSTACK_RUNTIME_DIR:-$HOME/.agentstack/runtime}"
HELPER="${AGENTSTACK_CHILD_RESUME_HELPER:-$INSTALL_HOME/hooks/child_resume.py}"
EXPIRED=false

usage() {
    cat >&2 <<'EOF'
Usage: agentstack-purge-child-resume [--runtime-dir DIR] AGENT_NAME
       agentstack-purge-child-resume [--runtime-dir DIR] --expired

Remove only retained Claude/Codex child resume credentials and generated runtime
material. Session receipts and transcripts are not removed.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --runtime-dir)
            [[ $# -ge 2 ]] || { usage; exit 2; }
            RUNTIME_DIR="$2"
            shift 2
            ;;
        --expired)
            EXPIRED=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --*)
            usage
            exit 2
            ;;
        *)
            [[ -z "${AGENT_NAME_TO_PURGE:-}" ]] || { usage; exit 2; }
            AGENT_NAME_TO_PURGE="$1"
            shift
            ;;
    esac
done

[[ -f "$HELPER" ]] || {
    echo "agentstack-purge-child-resume: helper is missing: $HELPER" >&2
    exit 1
}
if [[ "$EXPIRED" == true ]]; then
    [[ -z "${AGENT_NAME_TO_PURGE:-}" ]] || { usage; exit 2; }
    exec "${AGENTSTACK_PYTHON:-python3}" "$HELPER" purge \
        --runtime-dir "$RUNTIME_DIR" --expired
fi
[[ -n "${AGENT_NAME_TO_PURGE:-}" ]] || { usage; exit 2; }
exec "${AGENTSTACK_PYTHON:-python3}" "$HELPER" purge \
    --runtime-dir "$RUNTIME_DIR" "$AGENT_NAME_TO_PURGE"
