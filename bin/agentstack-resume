#!/usr/bin/env python3
"""Resume a stopped child through the dashboard API; never preregister it."""
import argparse
import json
import os
from pathlib import Path
import sys
import subprocess
import urllib.error
import urllib.request

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "hooks"))
import child_tools


def main():
    library = Path(__file__).resolve().parent / 'lib/agentstack-register.sh'
    implicit = library.parents[2] / 'runtime-client.json'
    explicit = os.environ.get('AGENTSTACK_CLIENT_CONFIG') or any(arg == '--context' or arg.startswith('--context=') for arg in sys.argv[1:])
    selected = explicit or implicit.exists() or implicit.is_symlink()
    if selected and library.is_file():
        # Older partial installs may contain a source-only register library.
        # Check its front door explicitly before accepting any success status.
        dispatch = '''source "$1"
shift
if ! declare -F ags_global_entry >/dev/null; then
  echo 'agentstack-resume: GLOBAL_ENTRY_UNAVAILABLE' >&2
  exit 2
fi
ags_global_entry resume-child "$@"
status=$?
if [[ "$status" == 125 ]]; then
  echo 'agentstack-resume: GLOBAL_ENTRY_UNAVAILABLE' >&2
  exit 2
fi
exit "$status"
'''
        result = subprocess.run(['/bin/bash', '-c', dispatch, 'agentstack-resume', str(library), *sys.argv[1:]])
        return result.returncode
    elif selected:
        print('agentstack-resume: GLOBAL_ENTRY_UNAVAILABLE',file=sys.stderr)
        return 2
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("name")
    parser.add_argument("--base", choices=["default", "mail-only"])
    parser.add_argument("--tools", action="append")
    parser.add_argument("--clear-tools", action="store_true")
    parser.add_argument("--detached", action="store_true")
    args = parser.parse_args()
    if args.clear_tools and args.tools:
        parser.error("--clear-tools and --tools cannot be combined")
    body = {"session": args.name}
    if args.base is not None:
        body["base"] = args.base
    try:
        if args.tools is not None:
            body["tools"] = child_tools.parse_cli(args.tools)
        elif args.clear_tools:
            body["tools"] = {}
        if args.detached:
            body["open"] = False
        port = int(os.environ.get("AGENTSTACK_PORT", "8770"))
        if not 1 <= port <= 65535:
            raise ValueError("AGENTSTACK_PORT must be a valid port")
        req = urllib.request.Request(f"http://127.0.0.1:{port}/api/jump",
            data=json.dumps(body).encode(), headers={"Content-Type": "application/json"}, method="POST")
        try:
            response = urllib.request.urlopen(req, timeout=60)
        except urllib.error.HTTPError as exc:
            response = exc
        with response:
            result = json.loads(response.read(65536))
        print(json.dumps(result, ensure_ascii=False))
        return 0 if isinstance(result, dict) and result.get("ok") is True else 1
    except (ValueError, OSError, child_tools.ToolsError) as exc:
        print(f"agentstack-resume: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
