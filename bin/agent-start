#!/usr/bin/env bash
# agent-start — launch a Claude Code agent inside a named tmux session in the
# current terminal tab, so it shows up in the dashboard and is click-to-jump-able.
#
# Directory selection (where `claude` runs):
#   agent-start [DIR]    use DIR explicitly
#   agent-start          if fzf is installed, browse under $AGENTSTACK_BASE_DIR
#                        (default: $HOME); otherwise fall back to the current dir
#
# Env:
#   AGENTSTACK_BASE_DIR   root the interactive picker browses (default: $HOME).
#                         Point this at your Obsidian vault to pick a subdir:
#                           export AGENTSTACK_BASE_DIR="$HOME/Obsidian/MyVault"
#   AGENTSTACK_CLAUDE_BIN claude binary (default: `claude` on PATH).
#   AGENTSTACK_CLAUDE_MODEL model label to register (default "claude-code").
#
# Registration, the adjective-scientist name, and the window/tab title are
# established before `claude` starts. Hooks still record later in-session
# registrations.
set -euo pipefail

AGS_PROG="agent-start"
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/agentstack-launch.sh
. "$BIN_DIR/lib/agentstack-launch.sh"
# shellcheck source=lib/agentstack-register.sh
. "$BIN_DIR/lib/agentstack-register.sh"
ags_load_env

CLAUDE_BIN="${AGENTSTACK_CLAUDE_BIN:-claude}"
CLAUDE_MODEL="${AGENTSTACK_CLAUDE_MODEL:-claude-code}"
PROJECT_KEY="${AGENTSTACK_PROJECT_KEY:-}"
MCP_URL="${AGENTSTACK_MCP_URL:-http://127.0.0.1:8765/mcp}"
MANAGED_FILE="${AGENTSTACK_MANAGED_AGENTS_FILE:-}"
HOOKS_DIR="${AGENTSTACK_HOOKS_DIR:-}"

TMUX_BIN="$(ags_resolve_tmux)"
[[ -n "$TMUX_BIN" ]] || ags_die "tmux not found (install tmux first)"
command -v "$CLAUDE_BIN" >/dev/null 2>&1 || ags_die "claude not found on PATH (set AGENTSTACK_CLAUDE_BIN)"

DIR="$(ags_choose_dir "$@")" || { echo "$AGS_PROG: cancelled" >&2; exit 0; }
[[ -n "$DIR" ]] || exit 0

# Prevent identity hijack: stale/inherited values must not select another agent
# or become part of a newly created tmux server's global environment.
unset AGENT_NAME PARENT_AGENT CHILD_REGISTRATION_TOKEN AGENTSTACK_RESERVED_IDENTITY 2>/dev/null || true

SESSION="pending-$$"
CANDIDATE_AGENT_NAME="$(ags_pick_adjective_scientist_name 2>/dev/null || true)"
if [[ -n "$CANDIDATE_AGENT_NAME" ]]; then
  AGENT_NAME="$CANDIDATE_AGENT_NAME"
  SESSION="$AGENT_NAME"
fi

if [[ -n "$PROJECT_KEY" ]]; then
  ags_mail_load_token
  if ags_mcp_call "health_check" >/dev/null 2>&1; then
    ags_start_mail_watcher "$TMUX_BIN" "$HOOKS_DIR"
    REGISTERED_AGENT_NAME=""
    if ags_register_session "$PROJECT_KEY" "claude-code" "$CLAUDE_MODEL" "cc" "$DIR" "$CANDIDATE_AGENT_NAME" "candidate" >/dev/null 2>&1; then
      REGISTERED_AGENT_NAME="${AGS_REGISTERED_AGENT_NAME:-}"
    fi
    if [[ -n "$REGISTERED_AGENT_NAME" ]]; then
      AGENT_NAME="$REGISTERED_AGENT_NAME"
      SESSION="$AGENT_NAME"
      if [[ "${AGS_AGENT_NAME_SUBSTITUTED:-0}" == "1" ]]; then
        echo "warning: agent-mail changed requested identity '${AGS_REQUESTED_AGENT_NAME:-$CANDIDATE_AGENT_NAME}' to '$REGISTERED_AGENT_NAME'; the tmux session will use the server-returned name" >&2
      fi
    else
      echo "warning: agent registration failed; launching Claude with preselected AGENT_NAME=${AGENT_NAME:-}" >&2
    fi
  else
    echo "warning: agent-mail unreachable at $MCP_URL; launching Claude with preselected AGENT_NAME=${AGENT_NAME:-}" >&2
  fi
else
  echo "warning: AGENTSTACK_PROJECT_KEY unset; launching Claude with preselected AGENT_NAME=${AGENT_NAME:-}" >&2
fi

if [[ -n "${AGENT_NAME:-}" ]]; then
  SESSION="$AGENT_NAME"
  ags_record_managed_agent "$MANAGED_FILE" "$AGENT_NAME"
  command -v pbcopy >/dev/null 2>&1 && printf '%s' "$AGENT_NAME" | pbcopy 2>/dev/null || true
fi

# Already inside a real tmux pane: register + run in place.
if [[ -n "${TMUX:-}" ]]; then
  if [[ -n "${AGENT_NAME:-}" ]]; then
    CURRENT_TMUX_SESSION="$("$TMUX_BIN" display-message -p '#S' 2>/dev/null || true)"
    if [[ "$CURRENT_TMUX_SESSION" != "$AGENT_NAME" ]]; then
      if "$TMUX_BIN" has-session -t "=$AGENT_NAME" 2>/dev/null; then
        ags_die "agent-mail registered as '$AGENT_NAME', but that tmux session already exists; refusing to continue as '$CURRENT_TMUX_SESSION'"
      fi
      if ! "$TMUX_BIN" rename-session "$AGENT_NAME" 2>/dev/null; then
        ags_die "agent-mail registered as '$AGENT_NAME', but tmux could not rename session '${CURRENT_TMUX_SESSION:-unknown}'; refusing an identity split"
      fi
      RENAMED_TMUX_SESSION="$("$TMUX_BIN" display-message -p '#S' 2>/dev/null || true)"
      if [[ "$RENAMED_TMUX_SESSION" != "$AGENT_NAME" ]]; then
        ags_die "tmux rename reported success but session is '${RENAMED_TMUX_SESSION:-unknown}', not registered identity '$AGENT_NAME'"
      fi
    fi
    export AGENT_NAME
  fi
  cd "$DIR"
  export CLAUDECODE=1
  # Warn (do not block) if this pane can't read a macOS privacy-protected project
  # dir — the child claude will inherit the same EPERM otherwise-undiagnosable.
  declare -F ags_warn_tcc_access >/dev/null 2>&1 && ags_warn_tcc_access "$DIR"
  exec "$CLAUDE_BIN"
fi

# Otherwise replace the current terminal tab with a fresh tmux session. Keep
# agent-specific values out of the tmux client environment. The non-secret name
# is session-scoped with `new-session -e`; the owner token is restored inside the
# target process from its mode-0600 runtime file, so it is never embedded in this
# temporary script or a process argument.
SESSION_AGENT_NAME="${AGENT_NAME:-}"
SESSION_TOKEN_FILE=""
if [[ -n "$SESSION_AGENT_NAME" ]]; then
  SESSION_TOKEN_FILE="$(ags_registration_token_file "$SESSION_AGENT_NAME" 2>/dev/null || true)"
fi
unset AGENT_NAME PARENT_AGENT CHILD_REGISTRATION_TOKEN AGENTSTACK_RESERVED_IDENTITY 2>/dev/null || true

INNER="$(mktemp -t agent-start.XXXXXX)"
cat > "$INNER" <<EOF
#!/usr/bin/env bash
cd $(printf '%q' "$DIR") || exit 1
unset AGENT_NAME PARENT_AGENT CHILD_REGISTRATION_TOKEN AGENTSTACK_RESERVED_IDENTITY 2>/dev/null || true
$(printf '%q' "$TMUX_BIN") new-session -s $(printf '%q' "$SESSION") -c $(printf '%q' "$DIR") \
  -e $(printf '%q' "AGENT_NAME=$SESSION_AGENT_NAME") \
  -e CLAUDECODE=1 \
  -e PARENT_AGENT= -e CHILD_REGISTRATION_TOKEN= -e AGENTSTACK_RESERVED_IDENTITY= \
  "if [ -n $(printf '%q' "$SESSION_TOKEN_FILE") ] && [ -r $(printf '%q' "$SESSION_TOKEN_FILE") ]; then IFS= read -r CHILD_REGISTRATION_TOKEN < $(printf '%q' "$SESSION_TOKEN_FILE") || true; export CHILD_REGISTRATION_TOKEN; fi; $(printf '%q' "$CLAUDE_BIN"); exec \"\$SHELL\" -l"
rm -f -- "\$0"
exec "\$SHELL" -l
EOF
chmod +x "$INNER"

echo "$AGS_PROG: launching Claude agent in tmux session '$SESSION' ($DIR)"
exec "$INNER"
