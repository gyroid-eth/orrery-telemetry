#!/usr/bin/env bash
# agent-start — launch a Claude Code agent inside a named tmux session and a
# terminal window, so it shows up in the dashboard and is click-to-jump-able.
#
# Directory selection (where `claude` runs):
#   agent-start [DIR]    use DIR explicitly
#   agent-start          if fzf is installed, browse under $AGENTSTACK_BASE_DIR
#                        (default: $HOME); otherwise fall back to the current dir
#
# Env:
#   AGENTSTACK_BASE_DIR   root the interactive picker browses (default: $HOME).
#                         Point this at your Obsidian vault to pick a subdir:
#                           export AGENTSTACK_BASE_DIR="$HOME/Obsidian/MyVault"
#   AGENTSTACK_TERMINAL   ghostty | iterm | terminal | auto (default: auto).
#   AGENTSTACK_CLAUDE_BIN claude binary (default: `claude` on PATH).
#
# Registration, the scientist name, and the window/tab title are handled by the
# shipped hooks (mark-agent-registered -> set-ghostty-title) once the agent
# registers with agent-mail. This launcher only starts `claude` in a named
# tmux session.
set -euo pipefail

AGS_PROG="agent-start"
# shellcheck source=lib/agentstack-launch.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/agentstack-launch.sh"
ags_load_env

CLAUDE_BIN="${AGENTSTACK_CLAUDE_BIN:-claude}"

TMUX_BIN="$(ags_resolve_tmux)"
[[ -n "$TMUX_BIN" ]] || ags_die "tmux not found (install tmux first)"
command -v "$CLAUDE_BIN" >/dev/null 2>&1 || ags_die "claude not found on PATH (set AGENTSTACK_CLAUDE_BIN)"

DIR="$(ags_choose_dir "$@")" || { echo "$AGS_PROG: cancelled" >&2; exit 0; }
[[ -n "$DIR" ]] || exit 0

# Prevent AGENT_NAME hijack: a stale/inherited value would make the new agent
# register under another agent's name. The hooks re-export it after register.
unset AGENT_NAME PARENT_AGENT 2>/dev/null || true

SESSION="pending-$$"

# Already inside a real tmux pane: run in place. set-ghostty-title renames the
# current session to the scientist name on register, so no new window is needed.
if [[ -n "${TMUX:-}" ]]; then
  cd "$DIR"
  exec "$CLAUDE_BIN"
fi

# Otherwise spawn a new terminal window with a fresh tmux session. The temp
# script keeps the window alive after claude exits (drops to a shell), then
# self-deletes.
INNER="$(mktemp -t agent-start.XXXXXX)"
cat > "$INNER" <<EOF
#!/usr/bin/env bash
cd $(printf '%q' "$DIR") || exit 1
$(printf '%q' "$TMUX_BIN") new-session -s $(printf '%q' "$SESSION") -c $(printf '%q' "$DIR") \
  "$(printf '%q' "$CLAUDE_BIN"); exec \"\$SHELL\" -l"
rm -f -- "\$0"
exec "\$SHELL" -l
EOF
chmod +x "$INNER"

if ! ags_spawn_terminal "$SESSION" "$INNER"; then
  rm -f -- "$INNER"
  cat >&2 <<MSG
$AGS_PROG: could not open a terminal automatically.
Run this yourself to launch the agent:
  $TMUX_BIN new-session -s $SESSION -c $DIR $CLAUDE_BIN
MSG
  exit 1
fi

echo "$AGS_PROG: launching Claude agent in tmux session '$SESSION' ($DIR)"
