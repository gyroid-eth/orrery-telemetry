#!/usr/bin/env python3
"""Mail/reservation lifecycle for delegated Antigravity children.

Secrets are read from a mode-0600 token file. They are never accepted as CLI
arguments or environment variables. The helper reuses the same narrow
AgentMailClient used by the child MCP proxy so schema/token compatibility stays
in one place.
"""
from __future__ import annotations

import argparse
import json
import os
import pathlib
import sys
from typing import Any


def _load_client_module() -> tuple[Any, Any]:
    here = pathlib.Path(__file__).resolve().parent
    home = pathlib.Path(os.environ.get("AGENTSTACK_HOME", "~/.agentstack")).expanduser()
    candidates = [
        here.parent / "integrations" / "codex_app" / "src",
        home / "integrations" / "codex_app" / "src",
        home / "integrations" / "codex_app" / "plugin" / "src",
    ]
    for source in candidates:
        if (source / "agentstack_codex_app" / "agent_mail_client.py").is_file():
            sys.path.insert(0, os.fspath(source))
            break
    else:
        raise SystemExit(
            "agentstack-gemini-child-mail: agentstack_codex_app source is unavailable"
        )
    from agentstack_codex_app.agent_mail_client import (  # type: ignore
        AgentMailClient,
        HttpJsonRpcTransport,
    )

    return AgentMailClient, HttpJsonRpcTransport


def _read_token(path: pathlib.Path) -> str:
    try:
        token = path.read_text(encoding="utf-8").strip()
        mode = path.stat().st_mode & 0o777
    except OSError as exc:
        raise SystemExit(f"cannot read child token file: {path}") from exc
    if not token:
        raise SystemExit(f"child token file is empty: {path}")
    if mode & 0o077:
        raise SystemExit(f"child token file permissions are too broad: {oct(mode)}")
    return token


def _bearer_token() -> str | None:
    mode = os.environ.get("AGENTSTACK_MAIL_HTTP_BEARER_MODE", "auto").strip().lower()
    if mode not in {"auto", "enabled", "disabled"}:
        raise SystemExit(f"invalid AGENTSTACK_MAIL_HTTP_BEARER_MODE: {mode}")
    if mode == "disabled":
        return None
    direct = os.environ.get("MCP_AGENT_MAIL_TOKEN", "").strip()
    if direct:
        return direct
    env_path = pathlib.Path(
        os.environ.get("AGENTSTACK_MAIL_ENV", "~/.agentstack/mail/.env")
    ).expanduser()
    if env_path.is_file():
        for line in env_path.read_text(encoding="utf-8").splitlines():
            key, sep, value = line.partition("=")
            if sep and key.strip() == "HTTP_BEARER_TOKEN":
                token = value.strip().strip("\"'")
                if token:
                    return token
                break
    if mode == "enabled":
        raise SystemExit("HTTP bearer mode is enabled but no bearer token is available")
    return None


def _client() -> Any:
    AgentMailClient, HttpJsonRpcTransport = _load_client_module()
    endpoint = os.environ.get("AGENTSTACK_MCP_URL", "http://127.0.0.1:18765/mcp")
    return AgentMailClient(
        HttpJsonRpcTransport(endpoint, bearer_token=_bearer_token(), timeout=30.0)
    )


def _paths(value: str) -> list[str]:
    paths = [item.strip() for item in value.split(",") if item.strip()]
    if not paths:
        raise SystemExit("at least one reservation path is required")
    for item in paths:
        path = pathlib.Path(item)
        if item.startswith("~") or path.is_absolute() or ".." in path.parts:
            raise SystemExit(
                f"reservation path must stay project-relative: {item}"
            )
    return paths


def _denied_action_names(value: Any) -> list[str]:
    if not isinstance(value, list):
        return []
    names: list[str] = []
    for item in value:
        if not isinstance(item, dict):
            continue
        action = item.get("action") or item.get("display_name")
        if isinstance(action, str) and action:
            names.append(action)
    return names


def _last_result(path: pathlib.Path) -> dict[str, Any]:
    result: dict[str, Any] | None = None
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise SystemExit(f"cannot read Antigravity result log: {path}") from exc
    for line in lines:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(event, dict) and event.get("event") == "result":
            candidate = event.get("result")
            if isinstance(candidate, dict):
                result = candidate
    return result or {"status": "UNKNOWN", "response": ""}


def _append_notice(response: str, notice: str) -> str:
    return f"{response}\n\n{notice}" if response else notice


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("reserve", "release", "report", "retire"))
    parser.add_argument("--project-key", required=True)
    parser.add_argument("--agent-name", required=True)
    parser.add_argument("--token-file", required=True, type=pathlib.Path)
    parser.add_argument("--paths", default="")
    parser.add_argument("--ttl", type=int, default=14400)
    parser.add_argument("--parent", default="")
    parser.add_argument("--result-log", type=pathlib.Path)
    parser.add_argument("--worktree", default="")
    parser.add_argument("--runner-status", type=int)
    args = parser.parse_args()

    token = _read_token(args.token_file)
    client = _client()

    if args.action == "reserve":
        client.reserve_files(
            project_key=args.project_key,
            agent_name=args.agent_name,
            registration_token=token,
            paths=_paths(args.paths),
            ttl_seconds=args.ttl,
            exclusive=True,
            reason="delegated Antigravity child",
        )
        return 0

    if args.action == "release":
        if not args.paths:
            return 0
        client.release_reservations(
            project_key=args.project_key,
            agent_name=args.agent_name,
            registration_token=token,
            paths=_paths(args.paths),
        )
        return 0

    if args.action == "retire":
        client.retire_agent(
            project_key=args.project_key,
            agent_name=args.agent_name,
            registration_token=token,
        )
        return 0

    if not args.parent:
        raise SystemExit("--parent is required for report")
    if args.result_log is None:
        raise SystemExit("--result-log is required for report")
    result = _last_result(args.result_log)
    status = str(result.get("status") or "UNKNOWN").upper()
    response = str(result.get("response") or "").strip()
    denied = _denied_action_names(result.get("denied_actions"))

    if denied:
        if status == "SUCCESS":
            status = "INCOMPLETE"
        response = _append_notice(
            response,
            "Antigravity denied required actions: " + ", ".join(denied),
        )
    if status == "SUCCESS" and not response:
        status = "INCOMPLETE"
        response = (
            "Antigravity headless run produced no textual response. "
            "Inspect the result and stderr logs."
        )
    if args.runner_status not in (None, 0):
        if status == "SUCCESS":
            status = "INCOMPLETE"
        response = _append_notice(
            response,
            f"ORRERY launcher observed non-zero child status {args.runner_status}.",
        )

    if len(response) > 12_000:
        response = response[:12_000] + "\n\n[truncated by launcher]"
    body = (
        f"Antigravity child `{args.agent_name}` finished with status `{status}`.\n\n"
        f"Worktree: `{args.worktree or 'unknown'}`\n\n"
        f"{response or '(no textual response)'}"
    )
    subject_state = "complete" if status == "SUCCESS" else "incomplete"
    client.send_message(
        project_key=args.project_key,
        agent_name=args.agent_name,
        registration_token=token,
        to=[args.parent],
        subject=f"Gemini child {subject_state}: {args.agent_name}",
        body_md=body,
        importance="normal" if status == "SUCCESS" else "high",
        ack_required=False,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
