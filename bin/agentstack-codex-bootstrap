#!/usr/bin/env bash
# agentstack-codex-bootstrap — register a Codex session with agent-mail.
#
# Codex has no Claude Code hook system, so unlike `claude` it does not register
# itself. This script does what the Claude hooks do: health-check ORRERY Mail,
# ensure the project, register the agent (with an Adjective-Scientist name),
# rename the tmux session to that name, and export AGENT_NAME for the Codex
# process that runs next.
#
# USAGE: source this script inside the target tmux session, before exec'ing
# codex:  source agentstack-codex-bootstrap [WORK_DIR]
# It preselects and exports AGENT_NAME as Adjective-Scientist before any network
# call when possible, so Codex can still launch and later register that name
# through its MCP client if shell registration is unavailable.
#
# Env (normally provided by ~/.agentstack/env.sh):
#   AGENTSTACK_PROJECT_KEY          ORRERY Mail project key (REQUIRED)
#   AGENTSTACK_MCP_URL              ORRERY Mail MCP endpoint (default :18765/mcp)
#   AGENTSTACK_MAIL_ENV             file holding HTTP_BEARER_TOKEN
#   AGENTSTACK_MANAGED_AGENTS_FILE  list the dashboard monitors (optional)
#   AGENTSTACK_HOOKS_DIR            dir of watch_agent_mail_signals.sh (optional)
#   AGENTSTACK_CODEX_MODEL          model label to register (default "codex")

WORK_DIR="${1:-.}"
if [ -n "${BASH_SOURCE:-}" ]; then _ags_bootstrap_src="${BASH_SOURCE[0]}"; else _ags_bootstrap_src="$0"; fi
SCRIPT_DIR="$(cd "$(dirname "$_ags_bootstrap_src")" && pwd)"
if [ -z "${AGENTSTACK_PROJECT_KEY:-}" ] && [ -f "$SCRIPT_DIR/../env.sh" ]; then . "$SCRIPT_DIR/../env.sh"; fi

PROJECT_KEY="${AGENTSTACK_PROJECT_KEY:-}"
MCP_URL="${AGENTSTACK_MCP_URL:-http://127.0.0.1:18765/mcp}"
MAIL_ENV="${AGENTSTACK_MAIL_ENV:-}"
MANAGED_FILE="${AGENTSTACK_MANAGED_AGENTS_FILE:-}"
HOOKS_DIR="${AGENTSTACK_HOOKS_DIR:-$SCRIPT_DIR/../hooks}"
RUNTIME_DIR="${AGENTSTACK_RUNTIME_DIR:-$HOME/.agentstack/runtime}"
CODEX_MODEL="${AGENTSTACK_CODEX_MODEL:-codex}"
RESERVED_IDENTITY="${AGENTSTACK_RESERVED_IDENTITY:-}"
CODEX_LAUNCH_KIND="${AGENTSTACK_CODEX_LAUNCH_KIND:-startup}"
case "$CODEX_LAUNCH_KIND" in
  startup|resume) ;;
  *) CODEX_LAUNCH_KIND="startup" ;;
esac
CODEX_RESUME_SESSION_ID="${AGENTSTACK_CODEX_RESUME_SESSION_ID:-}"
if [[ "$CODEX_LAUNCH_KIND" == "resume" ]]; then
  if [[ ! "$CODEX_RESUME_SESSION_ID" =~ ^[0-9A-Fa-f-]{8,}$ ]]; then
    echo "⚠️  resumed Codex session has no valid target session id; refusing to start." >&2
    return 1 2>/dev/null || exit 1
  fi
else
  CODEX_RESUME_SESSION_ID=""
fi
CODEX_LAUNCH_ORIGIN="${AGENTSTACK_CODEX_LAUNCH_ORIGIN:-}"
if [[ "$CODEX_LAUNCH_KIND" == "startup" ]]; then
  # Delegated children prepare their launch before exec and never source this
  # bootstrap. A regular cx/agent-start-codex launch is therefore standalone.
  CODEX_LAUNCH_ORIGIN="standalone"
else
  case "$CODEX_LAUNCH_ORIGIN" in
    child|standalone) ;;
    "")
      # Compatibility with a stage-3 dashboard built before origin became an
      # explicit resume environment field. Retained child validation below is
      # still authoritative, so this does not promote an unknown receipt.
      case "${AGENTSTACK_CODEX_CHILD_MCP_PROFILE:-}" in
        inherit|orrery-only) CODEX_LAUNCH_ORIGIN="child" ;;
        *)
          echo "⚠️  resumed Codex session has no verified launch origin; refusing to start." >&2
          return 1 2>/dev/null || exit 1
          ;;
      esac
      ;;
    *)
      echo "⚠️  resumed Codex session has an invalid launch origin; refusing to start." >&2
      return 1 2>/dev/null || exit 1
      ;;
  esac
fi
CODEX_CHILD_MCP_PROFILE=""
if [[ "$CODEX_LAUNCH_ORIGIN" == "child" ]]; then
  CODEX_CHILD_MCP_PROFILE="${AGENTSTACK_CODEX_CHILD_MCP_PROFILE:-}"
  case "$CODEX_CHILD_MCP_PROFILE" in
    inherit|orrery-only) ;;
    *)
      echo "⚠️  Codex child launch has no valid saved MCP profile; refusing to start." >&2
      return 1 2>/dev/null || exit 1
      ;;
  esac
elif [[ -n "${AGENTSTACK_CODEX_CHILD_MCP_PROFILE:-}" ]]; then
  echo "⚠️  standalone Codex launch cannot use a child MCP profile; refusing to start." >&2
  return 1 2>/dev/null || exit 1
fi
REQUIRE_FRESH_BINDING=0
if [[ "$RESERVED_IDENTITY" == "1" || "$CODEX_LAUNCH_KIND" == "resume" ]]; then
  REQUIRE_FRESH_BINDING=1
fi
# These two values are launcher-scoped capabilities, not ambient identity.
# Always discard inherited copies before creating this launch's pair.
unset AGENTSTACK_CODEX_LAUNCH_BINDING AGENTSTACK_CODEX_LAUNCH_ID 2>/dev/null || true
export AGENTSTACK_CODEX_LAUNCH_BINDING="" AGENTSTACK_CODEX_LAUNCH_ID=""
REQUESTED_AGENT_NAME=""
if [[ "$RESERVED_IDENTITY" == "1" && -n "${AGENT_NAME:-}" ]]; then
  REQUESTED_AGENT_NAME="$AGENT_NAME"
else
  # A bare inherited AGENT_NAME/token is not proof of an intentional child or
  # resume. Ignore it unless the launcher supplied the dedicated marker.
  unset AGENT_NAME PARENT_AGENT CHILD_REGISTRATION_TOKEN AGENTSTACK_RESERVED_IDENTITY 2>/dev/null || true
fi
# shellcheck source=lib/agentstack-register.sh
. "$SCRIPT_DIR/lib/agentstack-register.sh"

# Resolve a tmux binary (best effort; rename/watcher are skipped without one).
TMUX_BIN="$(command -v tmux 2>/dev/null || true)"
if [[ -z "$TMUX_BIN" ]]; then
  for _c in /opt/homebrew/bin/tmux /usr/local/bin/tmux; do
    [[ -x "$_c" ]] && { TMUX_BIN="$_c"; break; }
  done
fi

CANDIDATE_AGENT_NAME=""
REGISTER_MODE="candidate"
if [[ -n "$REQUESTED_AGENT_NAME" ]]; then
  CANDIDATE_AGENT_NAME="$REQUESTED_AGENT_NAME"
  REGISTER_MODE="reserved"
else
  CANDIDATE_AGENT_NAME="$(ags_pick_adjective_scientist_name 2>/dev/null || true)"
fi
if [[ -n "$CANDIDATE_AGENT_NAME" ]]; then
  AGENT_NAME="$CANDIDATE_AGENT_NAME"
  export AGENT_NAME
fi

TMUX_PREFLIGHT_CONFLICT=0
if [[ -n "${TMUX:-}" && -n "$TMUX_BIN" && -n "${AGENT_NAME:-}" ]]; then
  CURRENT_TMUX_SESSION="$("$TMUX_BIN" display-message -p '#S' 2>/dev/null || true)"
  if [[ "$CURRENT_TMUX_SESSION" != "$AGENT_NAME" ]] && \
     "$TMUX_BIN" has-session -t "=$AGENT_NAME" 2>/dev/null; then
    TMUX_PREFLIGHT_CONFLICT=1
    echo "⚠️  refusing identity registration: current tmux session '${CURRENT_TMUX_SESSION:-unknown}', target '$AGENT_NAME' already exists." >&2
  fi
fi

TMUX_IDENTITY_MATCHED=0
finalize_agent_name() {
  local current_session="" renamed_session=""
  if [[ -n "${TMUX:-}" && -n "$TMUX_BIN" && -n "${AGENT_NAME:-}" ]]; then
    current_session="$("$TMUX_BIN" display-message -p '#S' 2>/dev/null || true)"
    if [[ "$current_session" == "$AGENT_NAME" ]]; then
      TMUX_IDENTITY_MATCHED=1
    elif "$TMUX_BIN" rename-session "$AGENT_NAME" 2>/dev/null; then
      renamed_session="$("$TMUX_BIN" display-message -p '#S' 2>/dev/null || true)"
      if [[ "$renamed_session" == "$AGENT_NAME" ]]; then
        TMUX_IDENTITY_MATCHED=1
      else
        echo "⚠️  tmux rename-session reported success, but current session is '${renamed_session:-unknown}' instead of '$AGENT_NAME'." >&2
      fi
    else
      echo "⚠️  tmux rename-session failed: current session '${current_session:-unknown}', target identity '$AGENT_NAME' (the target session may already exist)." >&2
    fi
  elif [[ -n "${AGENT_NAME:-}" ]]; then
    echo "⚠️  cannot verify tmux session name for agent identity '$AGENT_NAME'." >&2
  fi
  if [[ "$TMUX_IDENTITY_MATCHED" == "1" ]]; then
    ags_record_managed_agent "$MANAGED_FILE" "${AGENT_NAME:-}"
    command -v pbcopy >/dev/null 2>&1 && printf '%s' "${AGENT_NAME:-}" | pbcopy 2>/dev/null || true
  fi
  export AGENT_NAME="${AGENT_NAME:-}"
  [[ -n "${CHILD_REGISTRATION_TOKEN:-}" ]] && export CHILD_REGISTRATION_TOKEN
  return 0
}

if [[ -z "$PROJECT_KEY" ]]; then
  if [[ "$REQUIRE_FRESH_BINDING" == "1" ]]; then
    echo "⚠️  AGENTSTACK_PROJECT_KEY unset; refusing to start a reserved/resumed Codex session without a fresh history binding expectation." >&2
    return 1 2>/dev/null || exit 1
  fi
  echo "⚠️  AGENTSTACK_PROJECT_KEY unset; launching Codex with preselected AGENT_NAME=${AGENT_NAME:-}." >&2
  finalize_agent_name
  if [[ -n "${TMUX:-}" && -n "${AGENT_NAME:-}" && "$TMUX_IDENTITY_MATCHED" != "1" ]]; then
    return 1 2>/dev/null || exit 1
  fi
  return 0 2>/dev/null || exit 0
fi

# Ensure the MCP token is available for the Codex MCP client and our curl calls.
ags_mail_load_token

# 1. health check — degrade gracefully if ORRERY Mail is down.
if ! ags_mcp_call "health_check" >/dev/null 2>&1; then
  if [[ "$REQUIRE_FRESH_BINDING" == "1" ]]; then
    echo "⚠️  ORRERY Mail unreachable at $MCP_URL; refusing to start a reserved/resumed Codex session without a fresh history binding expectation." >&2
    return 1 2>/dev/null || exit 1
  fi
  echo "⚠️  ORRERY Mail unreachable at $MCP_URL; launching Codex with preselected AGENT_NAME=${AGENT_NAME:-}." >&2
  finalize_agent_name
  if [[ -n "${TMUX:-}" && -n "${AGENT_NAME:-}" && "$TMUX_IDENTITY_MATCHED" != "1" ]]; then
    return 1 2>/dev/null || exit 1
  fi
  return 0 2>/dev/null || exit 0
fi

# 2. ensure the mail-watcher (delivers inbox signals into this tmux session).
ags_start_mail_watcher "$TMUX_BIN" "$HOOKS_DIR"

# 3. ensure_project + register_agent (reuse a child's reserved name if present).
REGISTERED_AGENT_NAME=""
REGISTER_STATUS=1
if [[ "$TMUX_PREFLIGHT_CONFLICT" != "1" ]]; then
  if ags_register_session "$PROJECT_KEY" "codex" "$CODEX_MODEL" "cx" "$WORK_DIR" "$CANDIDATE_AGENT_NAME" "$REGISTER_MODE" >/dev/null 2>&1; then
    REGISTER_STATUS=0
    REGISTERED_AGENT_NAME="${AGS_REGISTERED_AGENT_NAME:-}"
  else
    REGISTER_STATUS=$?
  fi
fi

if [[ "$REGISTER_STATUS" == "2" && "${AGS_AGENT_NAME_SUBSTITUTED:-0}" == "1" ]]; then
  echo "⚠️  ORRERY Mail changed reserved identity '${AGS_REQUESTED_AGENT_NAME:-$CANDIDATE_AGENT_NAME}' to '${AGS_SERVER_RETURNED_AGENT_NAME:-unknown}'; refusing to rename this child/resumed session away from its existing inbox." >&2
  return 1 2>/dev/null || exit 1
fi

if [[ -n "$REGISTERED_AGENT_NAME" ]]; then
  AGENT_NAME="$REGISTERED_AGENT_NAME"
  if [[ "${AGS_AGENT_NAME_SUBSTITUTED:-0}" == "1" ]]; then
    echo "⚠️  ORRERY Mail changed requested identity '${AGS_REQUESTED_AGENT_NAME:-$CANDIDATE_AGENT_NAME}' to '$REGISTERED_AGENT_NAME'; reconciling the current tmux session to the server-returned name." >&2
  fi
elif [[ "$TMUX_PREFLIGHT_CONFLICT" == "1" ]]; then
  echo "⚠️  agent registration skipped because the target tmux session name is already in use." >&2
else
  echo "⚠️  agent registration failed; launching Codex with preselected AGENT_NAME=${AGENT_NAME:-}." >&2
fi

finalize_agent_name
if [[ -z "$REGISTERED_AGENT_NAME" && "$REQUIRE_FRESH_BINDING" == "1" ]]; then
  echo "⚠️  reserved/resumed Codex identity could not be registered; refusing to start without a fresh history binding expectation." >&2
  return 1 2>/dev/null || exit 1
fi
if [[ -n "$REGISTERED_AGENT_NAME" ]]; then
  if [[ ! "${AGS_REGISTERED_AGENT_ID:-}" =~ ^[1-9][0-9]*$ ]]; then
    echo "⚠️  ORRERY Mail registration returned no numeric agent id; refusing to start without a fresh history binding expectation." >&2
    return 1 2>/dev/null || exit 1
  fi
  PREPARE_BINDING="$HOOKS_DIR/prepare-codex-session-binding.py"
  if [[ ! -f "$PREPARE_BINDING" ]]; then
    echo "⚠️  Codex history binding expectation helper is missing; refusing to start: $PREPARE_BINDING" >&2
    return 1 2>/dev/null || exit 1
  fi
  if ! CODEX_LAUNCH_INFO="$(
    PREPARE_ARGS=(
      --runtime-dir "$RUNTIME_DIR"
      --agent-id "$AGS_REGISTERED_AGENT_ID"
      --agent-name "$AGENT_NAME"
      --project-key "$PROJECT_KEY"
      --program codex
      --launch-kind "$CODEX_LAUNCH_KIND"
      --history-mode enabled
      --launch-origin "$CODEX_LAUNCH_ORIGIN"
    )
    if [[ "$CODEX_LAUNCH_ORIGIN" == "child" ]]; then
      PREPARE_ARGS+=(
        --codex-mcp-profile "$CODEX_CHILD_MCP_PROFILE"
      )
    fi
    if [[ "$CODEX_LAUNCH_KIND" == "resume" ]]; then
      PREPARE_ARGS+=(
        --resume-session-id "$CODEX_RESUME_SESSION_ID"
      )
    fi
    "${AGENTSTACK_PYTHON:-python3}" "$PREPARE_BINDING" \
      "${PREPARE_ARGS[@]}"
  )"; then
    echo "⚠️  Codex history binding expectation could not be written; refusing to start." >&2
    return 1 2>/dev/null || exit 1
  fi
  IFS=$'\t' read -r AGENTSTACK_CODEX_LAUNCH_BINDING AGENTSTACK_CODEX_LAUNCH_ID <<< "$CODEX_LAUNCH_INFO"
  export AGENTSTACK_CODEX_LAUNCH_BINDING AGENTSTACK_CODEX_LAUNCH_ID
  if [[ -z "$AGENTSTACK_CODEX_LAUNCH_BINDING" || -z "$AGENTSTACK_CODEX_LAUNCH_ID" ]]; then
    echo "⚠️  Codex history binding expectation was incomplete; refusing to start." >&2
    return 1 2>/dev/null || exit 1
  fi
fi
if [[ -n "${TMUX:-}" && -n "${AGENT_NAME:-}" && "$TMUX_IDENTITY_MATCHED" != "1" ]]; then
  return 1 2>/dev/null || exit 1
fi
RESUME_STATE_BEGUN=0
RESUME_HELPER="${AGENTSTACK_CHILD_RESUME_HELPER:-$HOOKS_DIR/child_resume.py}"
if [[ "$CODEX_LAUNCH_KIND" == "resume" && "$CODEX_LAUNCH_ORIGIN" == "child" ]]; then
  if [[ ! -f "$RESUME_HELPER" ]] || ! \
     "${AGENTSTACK_PYTHON:-python3}" "$RESUME_HELPER" begin-resume \
       --runtime-dir "$RUNTIME_DIR" \
       --agent-name "$AGENT_NAME" \
       --agent-id "$AGS_REGISTERED_AGENT_ID" \
       --project-key "$PROJECT_KEY" \
       --program codex \
       --mcp-profile "$CODEX_CHILD_MCP_PROFILE"; then
    echo "⚠️  retained Codex child state could not enter resume; refusing to start." >&2
    return 1 2>/dev/null || exit 1
  fi
  RESUME_STATE_BEGUN=1
fi
if [[ -n "$REGISTERED_AGENT_NAME" && "$TMUX_IDENTITY_MATCHED" == "1" ]]; then
  echo "✅ ORRERY Mail registered: $AGENT_NAME"
elif [[ -n "$REGISTERED_AGENT_NAME" ]]; then
  echo "⚠️  ORRERY Mail registered as $AGENT_NAME, but no tmux session name needed synchronization."
else
  echo "ℹ️  ORRERY Mail not registered; AGENT_NAME preselected: ${AGENT_NAME:-}"
fi

# Resume keeps the remote row retired until both credential-backed
# registration and a fresh binding expectation have succeeded.  This is the
# final bootstrap operation before the caller's `&& codex resume ...`.
if [[ "$CODEX_LAUNCH_KIND" == "resume" && "$CODEX_LAUNCH_ORIGIN" == "child" ]]; then
  if ! UNRETIRE_RESULT="$(
    ags_mcp_call "unretire_agent" \
      "project_key=$PROJECT_KEY" "agent_name=$AGENT_NAME"
  )" || \
     printf '%s' "$UNRETIRE_RESULT" | ags_mcp_has_error; then
    if [[ "$RESUME_STATE_BEGUN" == "1" ]]; then
      "${AGENTSTACK_PYTHON:-python3}" "$RESUME_HELPER" cancel-resume \
        --runtime-dir "$RUNTIME_DIR" \
        --agent-name "$AGENT_NAME" \
        --agent-id "$AGS_REGISTERED_AGENT_ID" \
        --project-key "$PROJECT_KEY" >/dev/null 2>&1 || \
        echo "⚠️  retained Codex child state could not be restored after unretire failure." >&2
    fi
    echo "⚠️  resumed Codex identity could not be unretired; refusing to start." >&2
    return 1 2>/dev/null || exit 1
  fi
fi
