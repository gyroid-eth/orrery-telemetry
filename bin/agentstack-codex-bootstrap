#!/usr/bin/env bash
# agentstack-codex-bootstrap — register a Codex session with agent-mail.
#
# Codex has no Claude Code hook system, so unlike `claude` it does not register
# itself. This script does what the Claude hooks do: health-check agent-mail,
# ensure the project, register the agent (with an AdjectiveScientist name),
# rename the tmux session to that name, and export AGENT_NAME for the Codex
# process that runs next.
#
# USAGE: source this script inside the target tmux session, before exec'ing
# codex:  source agentstack-codex-bootstrap [WORK_DIR]
# It preselects and exports AGENT_NAME as AdjectiveScientist before any network
# call when possible, so Codex can still launch and later register that name
# through its MCP client if shell registration is unavailable.
#
# Env (normally provided by ~/.agentstack/env.sh):
#   AGENTSTACK_PROJECT_KEY          agent-mail project key (REQUIRED)
#   AGENTSTACK_MCP_URL              agent-mail MCP endpoint (default :8765/mcp)
#   AGENTSTACK_MAIL_ENV             file holding HTTP_BEARER_TOKEN
#   AGENTSTACK_MANAGED_AGENTS_FILE  list the dashboard monitors (optional)
#   AGENTSTACK_HOOKS_DIR            dir of watch_agent_mail_signals.sh (optional)
#   AGENTSTACK_CODEX_MODEL          model label to register (default "codex")

WORK_DIR="${1:-.}"
if [ -n "${BASH_SOURCE:-}" ]; then _ags_bootstrap_src="${BASH_SOURCE[0]}"; else _ags_bootstrap_src="$0"; fi
SCRIPT_DIR="$(cd "$(dirname "$_ags_bootstrap_src")" && pwd)"
if [ -z "${AGENTSTACK_PROJECT_KEY:-}" ] && [ -f "$SCRIPT_DIR/../env.sh" ]; then . "$SCRIPT_DIR/../env.sh"; fi

PROJECT_KEY="${AGENTSTACK_PROJECT_KEY:-}"
MCP_URL="${AGENTSTACK_MCP_URL:-http://127.0.0.1:8765/mcp}"
MAIL_ENV="${AGENTSTACK_MAIL_ENV:-}"
MANAGED_FILE="${AGENTSTACK_MANAGED_AGENTS_FILE:-}"
HOOKS_DIR="${AGENTSTACK_HOOKS_DIR:-}"
CODEX_MODEL="${AGENTSTACK_CODEX_MODEL:-codex}"
REQUESTED_AGENT_NAME="${AGENT_NAME:-}"
# shellcheck source=lib/agentstack-register.sh
. "$SCRIPT_DIR/lib/agentstack-register.sh"

# Resolve a tmux binary (best effort; rename/watcher are skipped without one).
TMUX_BIN="$(command -v tmux 2>/dev/null || true)"
if [[ -z "$TMUX_BIN" ]]; then
  for _c in /opt/homebrew/bin/tmux /usr/local/bin/tmux; do
    [[ -x "$_c" ]] && { TMUX_BIN="$_c"; break; }
  done
fi

CANDIDATE_AGENT_NAME="$REQUESTED_AGENT_NAME"
REGISTER_MODE="reserved"
if [[ -z "$CANDIDATE_AGENT_NAME" ]]; then
  CANDIDATE_AGENT_NAME="$(ags_pick_adjective_scientist_name 2>/dev/null || true)"
  REGISTER_MODE="candidate"
fi
if [[ -n "$CANDIDATE_AGENT_NAME" ]]; then
  AGENT_NAME="$CANDIDATE_AGENT_NAME"
  export AGENT_NAME
fi

finalize_agent_name() {
  if [[ -n "${TMUX:-}" && -n "$TMUX_BIN" && -n "${AGENT_NAME:-}" ]]; then
    "$TMUX_BIN" rename-session "$AGENT_NAME" 2>/dev/null || true
  fi
  ags_record_managed_agent "$MANAGED_FILE" "${AGENT_NAME:-}"
  command -v pbcopy >/dev/null 2>&1 && printf '%s' "${AGENT_NAME:-}" | pbcopy 2>/dev/null || true
  export AGENT_NAME="${AGENT_NAME:-}"
  [[ -n "${CHILD_REGISTRATION_TOKEN:-}" ]] && export CHILD_REGISTRATION_TOKEN
}

if [[ -z "$PROJECT_KEY" ]]; then
  echo "⚠️  AGENTSTACK_PROJECT_KEY unset; launching Codex with preselected AGENT_NAME=${AGENT_NAME:-}." >&2
  finalize_agent_name
  return 0 2>/dev/null || exit 0
fi

# Ensure the MCP token is available for the Codex MCP client and our curl calls.
ags_mail_load_token

# 1. health check — degrade gracefully if agent-mail is down.
if ! ags_mcp_call "health_check" >/dev/null 2>&1; then
  echo "⚠️  agent-mail unreachable at $MCP_URL; launching Codex with preselected AGENT_NAME=${AGENT_NAME:-}." >&2
  finalize_agent_name
  return 0 2>/dev/null || exit 0
fi

# 2. ensure the mail-watcher (delivers inbox signals into this tmux session).
ags_start_mail_watcher "$TMUX_BIN" "$HOOKS_DIR"

# 3. ensure_project + register_agent (reuse a child's reserved name if present).
REGISTERED_AGENT_NAME=""
if ags_register_session "$PROJECT_KEY" "codex" "$CODEX_MODEL" "cx" "$WORK_DIR" "$CANDIDATE_AGENT_NAME" "$REGISTER_MODE" >/dev/null 2>&1; then
  REGISTERED_AGENT_NAME="${AGS_REGISTERED_AGENT_NAME:-}"
fi

if [[ -n "$REGISTERED_AGENT_NAME" ]]; then
  AGENT_NAME="$REGISTERED_AGENT_NAME"
else
  echo "⚠️  agent registration failed; launching Codex with preselected AGENT_NAME=${AGENT_NAME:-}." >&2
fi

finalize_agent_name
if [[ -n "$REGISTERED_AGENT_NAME" ]]; then
  echo "✅ agent-mail registered: $AGENT_NAME"
else
  echo "ℹ️  agent-mail not registered; AGENT_NAME preselected: ${AGENT_NAME:-}"
fi
