# claude-agent-stack dashboard configuration
#
# Copy entries into your shell environment or installer-generated service
# configuration when you need to override the defaults.

# Core install location.
# Default: ~/.agentstack
# AGENTSTACK_HOME=~/.agentstack

# Path where install.sh clones or reuses upstream mcp-agent-mail.
# Default: ~/mcp_agent_mail
# AGENTSTACK_MAIL_DIR=~/mcp_agent_mail

# Upstream mcp-agent-mail repository URL.
# Default: https://github.com/Dicklesworthstone/mcp_agent_mail.git
# AGENTSTACK_AGENT_MAIL_REPO=https://github.com/Dicklesworthstone/mcp_agent_mail.git

# Path to the mcp-agent-mail SQLite database.
# Default: ~/mcp_agent_mail/storage.sqlite3
# AGENTSTACK_MAIL_DB=~/mcp_agent_mail/storage.sqlite3

# Path to the mcp-agent-mail .env file used for HTTP_BEARER_TOKEN.
# Default: ~/mcp_agent_mail/.env
# AGENTSTACK_MAIL_ENV=~/mcp_agent_mail/.env

# mcp-agent-mail runtime/archive home used for inbox signal files.
# Default: ~/.mcp_agent_mail
# AGENTSTACK_MAIL_HOME=~/.mcp_agent_mail

# Optional explicit signal directory for the mail watcher.
# Default: ${AGENTSTACK_MAIL_HOME}/signals
# AGENTSTACK_SIGNALS_DIR=~/.mcp_agent_mail/signals

# mcp-agent-mail HTTP endpoint used by hooks.
# Default: http://127.0.0.1:8765/mcp
# AGENTSTACK_MCP_URL=http://127.0.0.1:8765/mcp

# Dashboard HTTP port.
# Default: 8770
# AGENTSTACK_PORT=8770

# Dashboard bind host. Keep the default for local-only access. Set to 0.0.0.0
# only on a trusted LAN/VPN, because the dashboard can expose live terminals.
# Default: 127.0.0.1
# AGENTSTACK_BIND_HOST=127.0.0.1

# Optional local portrait PNG overlay directory. Files here are served before
# bundled dashboard/portraits_64 files when names match.
# Default: unset
# AGENTSTACK_PORTRAITS_DIR=~/.agentstack/portraits_64

# Optional JSON file mapping registered agent names, lowercased, to portrait
# keys. Example content: {"mybot":"mybot"}.
# Default: unset
# AGENTSTACK_CUSTOM_PORTRAITS=~/.agentstack/custom_portraits.json

# launchd/systemd label prefix.
# Default: org.agentstack
# AGENTSTACK_LABEL_PREFIX=org.agentstack

# Terminal adapter for /api/jump: auto, ghostty, iterm, terminal, or none.
# Default: auto
# AGENTSTACK_TERMINAL=auto

# Optional agent-mail project human_key for DB filtering and signal lookup.
# Default: unset
# AGENTSTACK_PROJECT_KEY=

# Colon-separated absolute paths where file reservations are enforced.
# Default: AGENTSTACK_PROJECT_KEY when set; otherwise unset, which fail-opens
# and does not block edits.
# AGENTSTACK_PROTECTED_ROOTS=/path/to/project:/path/to/another/root

# Installed hook directory used by hook-to-hook calls.
# Default: the directory of the currently running hook script
# AGENTSTACK_HOOKS_DIR=~/.agentstack/hooks

# Runtime state directory for hook metadata, child-agent state, and logs.
# Default: ~/.claude/runtime
# AGENTSTACK_RUNTIME_DIR=~/.claude/runtime

# Optional managed-agents list written by spawn/title helpers.
# Default: ~/.claude/managed_agents.txt
# AGENTSTACK_MANAGED_AGENTS_FILE=~/.claude/managed_agents.txt

# Optional Obsidian vault path. Vault-backed dashboard features become no-ops
# when unset.
# Default: unset
# AGENTSTACK_VAULT=

# Python executable used by launchd template expansion.
# Default: /usr/bin/python3
# AGENTSTACK_PYTHON=/usr/bin/python3

# PATH used inside launchd services.
# Default: /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
# AGENTSTACK_PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
