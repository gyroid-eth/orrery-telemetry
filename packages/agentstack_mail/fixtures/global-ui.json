            "type": "integer",
            "minimum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "next_operations": {
        "type": "array",
        "items": {
          "enum": [
            "prepare-root",
            "replay-registration",
            "finalize-registration",
            "configure-provider",
            "launch",
            "launch-status",
            "registration-abandon",
            "repair-local-state"
          ]
        }
      },
      "reason": {
        "anyOf": [
