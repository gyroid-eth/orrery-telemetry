      "source": "packages/agentstack_mail/fixtures/global-server-s2b.json",
      "rule": "Generate messages_<tool> arguments from that tool input minus exactly the auth/ignored envelope listed here. Generate response data from exact tool output. All $refs belong to each schema document root; materialized fixture below is generated, not separately maintained. No contract_ref keyword passed to validator.",
      "strip_input_keys": [
        "agent_id",
        "agent_name",
        "authority_epoch",
        "candidate_generation",
        "expected_credential_generation",
        "expected_server_instance_id",
        "format",
        "project_key",
        "registration_token"
      ],
      "tool_limits": {
        "roster": 200,
        "search_messages": "limit 1..100",
        "summarize_thread": "HTTP limit maps to per_thread_limit 1..100; no limit field passed to tool",
        "fetch_topic": "limit 1..100",
        "activity": 100,
        "edge_messages": 100
      },
      "compiler": "Resolve local $ref against its own request/response document before common schema_contract.validate_schema_definition. Drop $defs after expansion; no runtime $ref keyword extension. Materialized nullable types are converted to existing anyOf syntax. Same compiler used by fixture and product."
