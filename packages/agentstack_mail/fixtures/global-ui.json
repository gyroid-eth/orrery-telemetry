            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "launch_status": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "properties": {
              "launch_id": {
                "type": "string"
              },
              "state_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "phase": {
                "type": "string"
              },
              "operator_required": {
                "type": "boolean"
              },
              "next_operations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "launch_id",
              "state_sha256",
              "phase",
              "operator_required",
              "next_operations"
            ],
            "additionalProperties": false
          }
        ]
      },
      "registration_sha256": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "ok",
      "client_name",
      "stage",
      "agent_id",
      "next_operations",
      "reason",
      "launch_status",
      "registration_sha256"
    ],
    "additionalProperties": false
