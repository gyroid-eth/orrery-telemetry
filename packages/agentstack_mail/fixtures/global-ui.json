  "spawn_status_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "const": true
      },
      "client_name": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "maxLength": 64
      },
      "stage": {
        "enum": [
          "absent",
          "root_only",
          "registration_pending",
          "registration_saved",
          "registered_unconfigured",
          "configured",
          "launch_present",
          "unavailable"
