{
  "description": "Forward sanitized Codex App lifecycle telemetry to AgentStack Bridge.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\"",
            "async": false,
            "timeoutSec": 1
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\"",
            "async": false,
            "timeoutSec": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\"",
            "async": false,
            "timeoutSec": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\"",
            "async": false,
            "timeoutSec": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\"",
            "async": false,
            "timeoutSec": 1
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\"",
            "async": false,
            "timeoutSec": 1
          }
        ]
      }
    ]
  }
}
