{
  "description": "Forward sanitized Codex App lifecycle telemetry to AgentStack Bridge.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\"",
            "async": false,
            "timeoutSec": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\"",
            "async": false,
            "timeoutSec": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\"",
            "async": false,
            "timeoutSec": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\"",
            "async": false,
            "timeoutSec": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\"",
            "async": false,
            "timeoutSec": 1
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-hook.sh\"",
            "async": false,
            "timeoutSec": 1
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-reservation-guard.sh\"",
            "async": false,
            "timeoutSec": 30,
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(exec_command|shell_command|shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-key-read-guard.sh\"",
            "async": false,
            "timeoutSec": 5,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
