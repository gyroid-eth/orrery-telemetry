# Generated installs write env.sh with mode 0600. Keep this sample token-free.
export AGENTSTACK_CODEX_APP_INSTALL_DIR="$HOME/.agentstack/integrations/codex_app"
export AGENTSTACK_CODEX_APP_RUNTIME_DIR="$HOME/.agentstack/runtime/codex-app"
export AGENTSTACK_CODEX_APP_SOCKET="$HOME/.agentstack/runtime/codex-app/bridge.sock"
export AGENTSTACK_CODEX_APP_SNAPSHOT="$HOME/.agentstack/runtime/codex-app/snapshot.json"
export AGENTSTACK_CODEX_APP_DELIVERY_DB="$HOME/.agentstack/runtime/codex-app/delivery.sqlite3"
export AGENTSTACK_PROJECT_KEY="/workspace/example"
export AGENTSTACK_MCP_URL="http://127.0.0.1:18765/mcp"
export AGENTSTACK_MAIL_ENV="$HOME/.agentstack/mail/.env"
export AGENTSTACK_SIGNALS_DIR="$HOME/.agentstack/mail/signals"
export AGENTSTACK_LABEL_PREFIX="org.agentstack"
export AGENTSTACK_CODEX_APP_LAUNCHD_LABEL="org.agentstack.codex-app-bridge"
export AGENTSTACK_CODEX_APP_WAKE_LIMIT_PER_HOUR="12"
export AGENTSTACK_CODEX_APP_STALE_AFTER_SECONDS="3600"
export AGENTSTACK_CODEX_APP_RETRY_MAX_ATTEMPTS="12"
export AGENTSTACK_CODEX_APP_RETRY_MAX_AGE_SECONDS="3600"
export AGENTSTACK_CODEX_APP_RETRY_MAX_BACKOFF_SECONDS="300"
export AGENTSTACK_CODEX_APP_PLUGIN_ID="agentstack-codex-app@agentstack-local"
export AGENTSTACK_CODEX_APP_SKIP_GIT_CHECK="0"
export AGENTSTACK_CODEX_BINARY="codex"
export AGENTSTACK_PYTHON="python3"
